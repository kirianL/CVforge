          {/* Floating Metrics Scorecard Bubble */}
          <div class="absolute top-20 left-12 bg-white/85 border border-zinc-200 rounded-2xl shadow-xl p-3.5 flex items-center gap-3 backdrop-blur-md floating-card select-none">
            <div class="relative flex items-center justify-center w-11 h-11">
              <svg class="w-full h-full transform -rotate-90">
                <circle cx="22" cy="22" r="19" class="stroke-zinc-100" stroke-width="3.5" fill="transparent" />
                <circle cx="22" cy="22" r="19" class="stroke-zinc-900" stroke-width="3.5" stroke-dasharray="119" stroke-dashoffset="2" stroke-linecap="round" fill="transparent" />
              </svg>
              <span class="absolute text-[11px] font-black tracking-tighter text-zinc-900">98%</span>
