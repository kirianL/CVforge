---
import Layout from '../layouts/Layout.astro';
import { getUserFromRequest } from '../lib/auth';

const user = await getUserFromRequest(Astro.request);
---

<Layout 
  title="CVForge | Generador de Currículums Optimizado para ATS"
  description="Crea un currículum profesional de una sola página, optimizado para pasar los filtros automáticos ATS de reclutamiento y exportable a PDF."
>
  <div class="min-h-screen bg-[#07090e] text-zinc-100 relative overflow-hidden flex flex-col font-sans select-none selection:bg-emerald-500/30 selection:text-emerald-200">
    {/* Technical Grid Overlay */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f29370f_1px,transparent_1px),linear-gradient(to_bottom,#1f29370f_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

    {/* Ambient Glows */}
    <div class="absolute -top-40 -left-40 h-[600px] w-[600px] rounded-full bg-violet-600/10 blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/2 -right-40 h-[500px] w-[500px] rounded-full bg-emerald-600/10 blur-[120px] pointer-events-none -translate-y-1/2"></div>
    <div class="absolute -bottom-40 left-1/3 h-[400px] w-[400px] rounded-full bg-blue-600/5 blur-[100px] pointer-events-none"></div>

    {/* Content Container */}
    <div class="mx-auto w-full max-w-7xl px-6 md:px-12 flex flex-col justify-between min-h-screen relative z-10 py-6">
      
      {/* Unified Header */}
      <header class="flex h-16 items-center justify-between border-b border-white/5 pb-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-tr from-emerald-400 to-teal-500 text-zinc-950 font-extrabold text-xl shadow-[0_0_15px_-3px_rgba(16,185,129,0.5)]">
            CF
          </div>
          <span class="text-xl font-bold tracking-tight text-white">CV<span class="text-emerald-400">Forge</span></span>
        </div>

        {/* Minimal Nav Links */}
        <nav class="hidden md:flex items-center gap-8 text-xs font-bold uppercase tracking-wider text-zinc-400">
          <a href="#features" class="hover:text-white transition-colors duration-200">Características</a>
          <a href="#editor" class="hover:text-white transition-colors duration-200">Editor</a>
          <a href="https://github.com/kirianL/CVforge" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-200">GitHub</a>
        </nav>

        {/* Auth Actions */}
        <div class="flex items-center gap-4">
          {user ? (
            <>
              <span class="text-xs font-bold text-zinc-400 hidden sm:inline">Hola, {user.name}</span>
              <a 
                href="/dashboard" 
                class="inline-flex h-9 items-center justify-center rounded-full bg-emerald-500 hover:bg-emerald-400 px-4 text-xs font-bold text-zinc-950 transition-all shadow-md active:scale-95 cursor-pointer shadow-[0_0_15px_-3px_rgba(16,185,129,0.3)]"
              >
                Ir al Panel
              </a>
            </>
          ) : (
            <>
              <a href="/login" class="text-xs font-bold text-zinc-400 hover:text-white transition-colors duration-200">
                Entrar
              </a>
              <a 
                href="/register" 
                class="inline-flex h-9 items-center justify-center rounded-full bg-white px-4 text-xs font-bold text-zinc-900 hover:bg-zinc-100 transition-all shadow-md active:scale-95 cursor-pointer"
              >
                Crear CV Gratis
              </a>
            </>
          )}
        </div>
      </header>

      {/* Main SaaS Hero Section */}
      <main class="py-16 md:py-24 flex flex-col lg:grid lg:grid-cols-12 gap-12 lg:gap-8 items-center my-auto">
        
        {/* Left Side: Pitch */}
        <div class="lg:col-span-6 text-center lg:text-left space-y-6 max-w-xl mx-auto lg:mx-0">
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.05] text-transparent bg-clip-text bg-gradient-to-b from-white via-zinc-100 to-zinc-400">
            Currículos, <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-emerald-400 to-teal-300 bg-clip-text text-transparent">sin papeleo.</span>
          </h1>

          <p class="text-base sm:text-lg leading-relaxed text-zinc-400 max-w-md mx-auto lg:mx-0 font-medium">
            Crea al instante un currículum profesional de alto rendimiento y optimizado para superar filtros de contratación automáticos (ATS). Autoguardado en tiempo real y descarga PDF 100% gratuita.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row gap-4 items-center justify-center lg:justify-start">
            <a 
              href={user ? "/dashboard" : "/register"} 
              class="w-full sm:w-auto inline-flex h-12 items-center justify-center rounded-full bg-emerald-500 px-8 text-sm font-bold text-zinc-950 shadow-lg hover:bg-emerald-400 hover:scale-[1.02] active:scale-95 transition-all cursor-pointer shadow-[0_4px_20px_-4px_rgba(16,185,129,0.4)]"
            >
              Comenzar gratis
            </a>
            <a 
              href="#features" 
              class="text-xs font-bold uppercase tracking-wider text-zinc-400 hover:text-white transition-colors py-2 flex items-center gap-1 group"
            >
              Ver características 
              <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
            </a>
          </div>
        </div>

        {/* Right Side: Animated ASCII Terminal Scanner */}
        <div class="lg:col-span-6 w-full max-w-lg mx-auto lg:ml-auto">
          <div class="relative group">
            {/* Ambient terminal backglow */}
            <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-emerald-500/20 to-teal-500/20 opacity-70 blur-xl group-hover:opacity-100 transition duration-500"></div>
            
            <div class="relative rounded-2xl border border-white/10 bg-zinc-950/80 backdrop-blur-md p-4 shadow-2xl text-left font-mono text-[11px] sm:text-xs text-emerald-400 select-none overflow-hidden">
              
              {/* Terminal Top Window Buttons */}
              <div class="flex items-center justify-between border-b border-white/5 pb-3 mb-3">
                <div class="flex items-center gap-1.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[#27c93f]"></span>
                </div>
                <span class="text-[9px] text-zinc-500 font-bold tracking-wide font-mono">cvforge-ats-scanner v1.0.0</span>
                <div class="h-2.5 w-2.5"></div>
              </div>

              {/* Animating Code block */}
              <pre 
                id="terminal-content" 
                class="h-64 overflow-y-auto leading-relaxed whitespace-pre-wrap font-mono scrollbar-none pr-1"
              ></pre>

              {/* Pulsing scan bar overlay effect */}
              <div class="absolute inset-x-0 h-1/4 bg-emerald-500/5 pointer-events-none animate-scan"></div>
            </div>
          </div>
        </div>
      </main>

      {/* Footer Block */}
      <footer class="border-t border-white/5 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 font-medium">
        <p>© 2026 CVForge. Diseñado para optimizar tu carrera.</p>
        <div class="flex items-center gap-6">
          <a href="/login" class="hover:text-white transition-colors duration-200">Acceso</a>
          <a href="/register" class="hover:text-white transition-colors duration-200">Registro</a>
        </div>
      </footer>
    </div>
  </div>

  {/* Terminal animation script */}
  <script>
    const lines = [
      "[SYSTEM] Conectando a Neon Serverless PostgreSQL...",
      "[SYSTEM] Base de datos conectada correctamente.",
      "[SYSTEM] Inicializando motor de escaneo de filtros ATS...",
      "[SYSTEM] Cargando diccionario de palabras clave del sector IT...",
      "",
      ">> ESCANEANDO ARCHIVO: \"Kirian_Luna_CV_ATS.pdf\"",
      ">> Extrayendo campos estructurados del perfil...",
      "   ✓ Información personal (Nombre, Email, Teléfono, Ubicación)",
      "   ✓ Sección Educación (Bachillerato Ingeniería del Software)",
      "   ✓ Sección Habilidades (Astro, React, Zustand, Neon, Prisma)",
      "",
      ">> Validando longitud de perfil y descripciones de experiencia...",
      "   ✓ Resumen profesional: 184 caracteres (> 100 mínimo)",
      "   ✓ Puestos de trabajo: Descripciones con descripción de logros",
      "",
      ">> Analizando coincidencia de palabras clave automáticas...",
      "   [▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓] 100% COMPLETO",
      "",
      "----------------------------------------------------------",
      "|           REPORTE GENERAL DE COINCIDENCIA ATS          |",
      "|                                                        |",
      "|  ÍNDICE DE COMPATIBILIDAD:  [ 98% / 100% ]             |",
      "|  NIVEL DE OPTIMIZACIÓN:     EXCELENTE (APROBADO)        |",
      "|  RECOMENDACIÓN:             COMPLETAMENTE APTO         |",
      "----------------------------------------------------------",
      "",
      ">> ¡Listo! El currículum superará los filtros automáticos.",
      ">> Redirigiendo al usuario al panel de CVForge..."
    ];

    const pre = document.getElementById('terminal-content');
    let lineIdx = 0;

    function printNextLine() {
      if (!pre) return;
      if (lineIdx < lines.length) {
        pre.textContent += lines[lineIdx] + '\n';
        lineIdx++;
        // Auto scroll a la parte inferior
        pre.scrollTop = pre.scrollHeight;

        // Tiempos variables para dar sensación orgánica de carga
        const delay = lines[lineIdx - 1] === "" 
          ? 100 
          : lines[lineIdx - 1].startsWith("   ") 
          ? 150 
          : lines[lineIdx - 1].startsWith("---") 
          ? 350
          : 250;

        setTimeout(printNextLine, delay);
      } else {
        // Reiniciar animación después de 8 segundos
        setTimeout(() => {
          pre.textContent = "";
          lineIdx = 0;
          printNextLine();
        }, 8000);
      }
    }

    // Iniciar la animación al cargar
    setTimeout(printNextLine, 500);
  </script>

  <style is:global>
    /* Ocultar barra de scroll en terminal */
    .scrollbar-none::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-none {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Animación de barrido de radar de la terminal */
    @keyframes scan {
      0% {
        top: 0%;
      }
      50% {
        top: 75%;
      }
      100% {
        top: 0%;
      }
    }
    .animate-scan {
      animation: scan 6s linear infinite;
    }
  </style>
</Layout>
