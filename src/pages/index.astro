---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Header / Navigation -->
  <header class="sticky top-0 z-50 w-full border-b border-zinc-200/50 bg-white/70 backdrop-blur-md dark:border-zinc-800/30 dark:bg-zinc-950/70">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-black text-white font-bold text-xl dark:bg-white dark:text-black">
          CF
        </div>
        <span class="text-xl font-bold tracking-tight">CV<span class="text-zinc-500">Forge</span></span>
      </div>
      
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-600 dark:text-zinc-400">
        <a href="#features" class="hover:text-black dark:hover:text-white transition-colors">Características</a>
        <a href="#templates" class="hover:text-black dark:hover:text-white transition-colors">Plantillas</a>
        <a href="#about" class="hover:text-black dark:hover:text-white transition-colors">Cómo funciona</a>
      </nav>

      <div class="flex items-center gap-4">
        <a href="/login" class="text-sm font-medium text-zinc-600 hover:text-black dark:text-zinc-400 dark:hover:text-white transition-colors">
          Entrar
        </a>
        <a 
          href="/editor" 
          class="inline-flex h-9 items-center justify-center rounded-md bg-black px-4 text-sm font-medium text-white shadow-sm hover:bg-zinc-800 active:scale-98 transition-all dark:bg-white dark:text-black dark:hover:bg-zinc-200"
        >
          Crear CV Gratis
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <!-- Gradient background effects -->
    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
      <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-[36rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-violet-200 to-indigo-100 opacity-60 sm:left-[calc(50%-30rem)] sm:w-[72rem]"></div>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/50 px-3 py-1 text-xs font-semibold text-zinc-800 shadow-sm backdrop-blur-sm dark:border-zinc-800 dark:bg-zinc-900/50 dark:text-zinc-200 mb-6">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
          100% Optimizado para Filtros ATS de Reclutamiento
        </div>

        <h1 class="text-5xl font-extrabold tracking-tight sm:text-6xl text-balance">
          Forja un currículum <span class="bg-gradient-to-r from-violet-600 to-indigo-650 bg-clip-text text-transparent">invencible</span> frente a los ATS.
        </h1>
        
        <p class="mt-6 text-lg leading-8 text-zinc-650 dark:text-zinc-400 text-pretty">
          Diseña tu currículum profesional utilizando plantillas validadas por reclutadores. Pasa el filtro automático de los ATS y descarga en PDF sin cobros sorpresa.
        </p>
        
        <div class="mt-10 flex items-center justify-center gap-x-6">
          <a 
            href="/editor" 
            class="rounded-md bg-black px-6 py-3 text-base font-semibold text-white shadow-md hover:bg-zinc-800 active:scale-98 transition-all dark:bg-white dark:text-black dark:hover:bg-zinc-200"
          >
            Comenzar a Editar
          </a>
          <a href="#features" class="text-sm font-semibold leading-6 hover:text-zinc-600 transition-colors">
            Ver Características <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Editor Mockup / Preview -->
      <div class="mt-16 sm:mt-24 relative rounded-xl border border-zinc-200/80 bg-zinc-50/50 p-4 shadow-xl dark:border-zinc-800/80 dark:bg-zinc-900/30">
        <div class="flex items-center justify-between border-b border-zinc-200/60 pb-3 mb-4 dark:border-zinc-800/60">
          <div class="flex items-center gap-1.5">
            <span class="h-3 w-3 rounded-full bg-red-400"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
            <span class="h-3 w-3 rounded-full bg-green-400"></span>
          </div>
          <span class="text-xs font-mono text-zinc-500">cvforge.dev/editor/mi-cv</span>
          <div class="h-3 w-3 opacity-0"></div>
        </div>

        <!-- Simulated Two-Panel Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 rounded-lg overflow-hidden bg-white dark:bg-zinc-950 min-h-[400px]">
          <!-- Left side: forms -->
          <div class="lg:col-span-5 border-r border-zinc-200/50 p-6 dark:border-zinc-800/50 bg-zinc-50/20">
            <div class="space-y-4">
              <div class="space-y-2">
                <div class="h-3 w-24 bg-zinc-300 rounded dark:bg-zinc-700"></div>
                <div class="h-9 w-full bg-zinc-100 rounded border border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800"></div>
              </div>
              <div class="space-y-2">
                <div class="h-3 w-32 bg-zinc-300 rounded dark:bg-zinc-700"></div>
                <div class="h-20 w-full bg-zinc-100 rounded border border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800"></div>
              </div>
              <div class="space-y-2">
                <div class="h-3 w-28 bg-zinc-300 rounded dark:bg-zinc-700"></div>
                <div class="space-y-2">
                  <div class="h-12 w-full bg-zinc-100 rounded border border-zinc-200 flex items-center justify-between px-3 dark:bg-zinc-900 dark:border-zinc-800">
                    <span class="h-2.5 w-40 bg-zinc-350 rounded dark:bg-zinc-655"></span>
                    <span class="h-5 w-5 bg-zinc-200 rounded dark:bg-zinc-800"></span>
                  </div>
                  <div class="h-12 w-full bg-zinc-100 rounded border border-zinc-200 flex items-center justify-between px-3 dark:bg-zinc-900 dark:border-zinc-800">
                    <span class="h-2.5 w-24 bg-zinc-350 rounded dark:bg-zinc-655"></span>
                    <span class="h-5 w-5 bg-zinc-200 rounded dark:bg-zinc-800"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Right side: resume page sheet -->
          <div class="lg:col-span-7 bg-zinc-100 p-8 flex justify-center dark:bg-zinc-900/60">
            <div class="w-full max-w-[280px] sm:max-w-[380px] aspect-[1/1.414] bg-white shadow-lg border border-zinc-200/50 p-6 flex flex-col gap-4 dark:bg-zinc-950 dark:border-zinc-900">
              <div class="flex flex-col gap-1">
                <div class="h-4 w-40 bg-zinc-900 rounded dark:bg-white"></div>
                <div class="h-2.5 w-60 bg-zinc-400 rounded dark:bg-zinc-600"></div>
              </div>
              <hr class="border-zinc-200/60 dark:border-zinc-900" />
              <div class="space-y-2">
                <div class="h-3 w-16 bg-zinc-900 rounded dark:bg-white"></div>
                <div class="h-2 w-full bg-zinc-200 rounded dark:bg-zinc-800"></div>
                <div class="h-2 w-5/6 bg-zinc-200 rounded dark:bg-zinc-800"></div>
              </div>
              <div class="space-y-2">
                <div class="h-3 w-24 bg-zinc-900 rounded dark:bg-white"></div>
                <div class="flex justify-between items-start">
                  <div class="space-y-1.5 w-2/3">
                    <div class="h-2.5 w-32 bg-zinc-800 rounded dark:bg-zinc-300"></div>
                    <div class="h-2 w-full bg-zinc-200 rounded dark:bg-zinc-800"></div>
                    <div class="h-2 w-4/5 bg-zinc-200 rounded dark:bg-zinc-800"></div>
                  </div>
                  <div class="h-2.5 w-16 bg-zinc-300 rounded dark:bg-zinc-700"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-24 sm:py-32 bg-zinc-50 dark:bg-zinc-900/20 border-y border-zinc-200/40 dark:border-zinc-900/40">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-16">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Creado para ayudarte a destacar</h2>
        <p class="mt-4 text-zinc-600 dark:text-zinc-400">Todo lo necesario para pasar los algoritmos automáticos de contratación de las empresas.</p>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Feature 1 -->
        <div class="rounded-xl border border-zinc-250/50 bg-white p-6 shadow-sm dark:border-zinc-800/50 dark:bg-zinc-950">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-400 mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold">100% Compatible con ATS</h3>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Esqueleto estructurado y textos parseables sin formatos oscuros que rompan los sistemas automáticos.</p>
        </div>

        <!-- Feature 2 -->
        <div class="rounded-xl border border-zinc-250/50 bg-white p-6 shadow-sm dark:border-zinc-800/50 dark:bg-zinc-950">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400 mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5h.075c.57 0 1.099.276 1.424.757L6 6.75m0 0-.121.243a26.27 26.27 0 0 0-2.83 4.977c-.317.67.224 1.43.954 1.43h1.43m0 0 1.43-2.5m-1.43 2.5 1.43 2.5m-3.411-2.5h8.54m1.428-9.75H19.5a2.25 2.25 0 0 1 2.25 2.25v13.5a2.25 2.25 0 0 1-2.25 2.25h-9.284c-.29 0-.582-.05-.858-.148L10.5 18.75M3.75 4.5h.075c.57 0 1.099.276 1.424.757L6 6.75m0 0-.121.243a26.27 26.27 0 0 0-2.83 4.977c-.317.67.224 1.43.954 1.43H6M19.5 4.5h.008v.008h-.008V4.5Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold">Costo Inicial de $0</h3>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Sin límites de pago engañosos. Crea tu perfil profesional e imprímelo gratis directamente desde tu navegador.</p>
        </div>

        <!-- Feature 3 -->
        <div class="rounded-xl border border-zinc-250/50 bg-white p-6 shadow-sm dark:border-zinc-800/50 dark:bg-zinc-950">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-950/50 dark:text-amber-400 mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold">Autosalvado Instantáneo</h3>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Tus cambios se guardan automáticamente a medida que escribes. No pierdas nunca tu información.</p>
        </div>

        <!-- Feature 4 -->
        <div class="rounded-xl border border-zinc-250/50 bg-white p-6 shadow-sm dark:border-zinc-800/50 dark:bg-zinc-950">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-pink-50 text-pink-650 dark:bg-pink-950/50 dark:text-pink-400 mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
            </svg>
          </div>
          <h3 class="text-lg font-bold">Compartir por URL</h3>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Publica tu currículum en un enlace único optimizado para SEO, facilitando el acceso rápido a los reclutadores.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-zinc-200/50 dark:border-zinc-800/30 py-12 bg-white dark:bg-zinc-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center text-sm text-zinc-500">
      <p>© 2026 CVForge. Forjando currículums invencibles.</p>
    </div>
  </footer>
</Layout>
