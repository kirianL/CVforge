---
import Layout from '../layouts/Layout.astro';
import { getUserFromRequest } from '../lib/auth';

const user = await getUserFromRequest(Astro.request);
---

<Layout 
  title="CVForge | Generador de Currículums Optimizado para ATS"
  description="Crea un currículum profesional de una sola página, optimizado para pasar los filtros automáticos ATS de reclutamiento y exportable a PDF."
>
  <div class="landing min-h-screen bg-[#0a0a0a] text-zinc-100 flex flex-col font-sans relative overflow-hidden">

    {/* ── Subtle noise texture ── */}
    <div class="absolute inset-0 opacity-[0.015] pointer-events-none" style="background-image:url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E')"></div>

    {/* ── Soft radial vignette ── */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(120,119,198,0.06),transparent)] pointer-events-none"></div>

    {/* ══════════ Content shell ══════════ */}
    <div class="mx-auto w-full max-w-[1120px] px-5 sm:px-8 flex flex-col min-h-screen relative z-10">

      {/* ── Header ── */}
      <header class="flex h-14 items-center justify-between shrink-0 py-4">
        <a href="/" class="flex items-center gap-2 no-underline">
          <span class="text-[15px] font-semibold tracking-tight text-white">CVForge</span>
        </a>

        {/* Desktop nav */}
        <nav class="hidden md:flex items-center gap-6 text-[13px] text-zinc-500">
          <a href="#features" class="hover:text-zinc-200 transition-colors duration-150">Características</a>
          <a href="#editor" class="hover:text-zinc-200 transition-colors duration-150">Editor</a>
          <a href="https://github.com/kirianL/CVforge" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-200 transition-colors duration-150">GitHub</a>
        </nav>

        <div class="flex items-center gap-3">
          {user ? (
            <>
              <span class="text-[13px] text-zinc-500 hidden sm:inline">{user.name}</span>
              <a 
                href="/dashboard" 
                class="inline-flex h-8 items-center justify-center rounded-lg bg-white px-3.5 text-[13px] font-medium text-zinc-900 hover:bg-zinc-200 active:scale-[0.97] transition-all cursor-pointer"
              >
                Dashboard
              </a>
            </>
          ) : (
            <>
              <a href="/login" class="hidden sm:inline text-[13px] text-zinc-500 hover:text-zinc-200 transition-colors duration-150">
                Entrar
              </a>
              <a 
                href="/register" 
                class="inline-flex h-8 items-center justify-center rounded-lg bg-white px-3.5 text-[13px] font-medium text-zinc-900 hover:bg-zinc-200 active:scale-[0.97] transition-all cursor-pointer"
              >
                Comenzar
              </a>
            </>
          )}

          {/* Mobile menu */}
          <button 
            id="mobile-menu-btn"
            type="button"
            class="md:hidden flex flex-col items-center justify-center w-8 h-8 gap-[5px] rounded-md hover:bg-white/5 transition-colors cursor-pointer"
            aria-label="Abrir menú"
          >
            <span class="hamburger-line block w-[18px] h-[1.5px] bg-zinc-400 rounded-full transition-all duration-300 origin-center"></span>
            <span class="hamburger-line block w-[18px] h-[1.5px] bg-zinc-400 rounded-full transition-all duration-300 origin-center"></span>
          </button>
        </div>
      </header>

      {/* Thin separator */}
      <div class="h-px bg-white/[0.06]"></div>

      {/* ── Mobile nav drawer ── */}
      <div id="mobile-nav" class="md:hidden overflow-hidden transition-all duration-300 ease-out" style="max-height:0;opacity:0">
        <nav class="flex flex-col py-3 border-b border-white/[0.06]">
          <a href="#features" class="mobile-nav-link px-2 py-2.5 text-[14px] text-zinc-400 hover:text-white transition-colors duration-150">Características</a>
          <a href="#editor" class="mobile-nav-link px-2 py-2.5 text-[14px] text-zinc-400 hover:text-white transition-colors duration-150">Editor</a>
          <a href="https://github.com/kirianL/CVforge" target="_blank" rel="noopener noreferrer" class="mobile-nav-link px-2 py-2.5 text-[14px] text-zinc-400 hover:text-white transition-colors duration-150">GitHub</a>
          {!user && (
            <a href="/login" class="mobile-nav-link px-2 py-2.5 text-[14px] text-zinc-400 hover:text-white transition-colors duration-150">Iniciar sesión</a>
          )}
        </nav>
      </div>

      {/* ══════════ Hero ══════════ */}
      <main class="flex-1 flex flex-col items-center justify-center py-16 sm:py-20 md:py-0">
        <div class="w-full max-w-3xl mx-auto text-center space-y-6 sm:space-y-8">

          {/* Headline */}
          <h1 class="text-[2.25rem] sm:text-[3.25rem] md:text-[3.75rem] lg:text-[4.25rem] font-semibold leading-[1.08] tracking-[-0.03em] text-white">
            Crea currículos que <br class="hidden sm:inline"/>
            <span class="text-zinc-500">superan filtros ATS.</span>
          </h1>

          {/* Subtitle */}
          <p class="text-[15px] sm:text-[17px] leading-relaxed text-zinc-500 max-w-lg mx-auto">
            Editor en tiempo real, formato profesional validado por reclutadores y exportación PDF gratuita. Sin distracciones.
          </p>

          {/* CTA row */}
          <div class="flex flex-col sm:flex-row gap-3 items-center justify-center pt-2">
            <a 
              href={user ? "/dashboard" : "/register"} 
              class="w-full sm:w-auto inline-flex h-10 sm:h-11 items-center justify-center rounded-lg bg-white px-5 sm:px-6 text-[14px] font-medium text-zinc-900 hover:bg-zinc-200 active:scale-[0.97] transition-all cursor-pointer"
            >
              Comenzar gratis →
            </a>
            <a 
              href="https://github.com/kirianL/CVforge"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex h-10 sm:h-11 items-center justify-center rounded-lg border border-white/[0.08] bg-transparent px-5 sm:px-6 text-[14px] font-medium text-zinc-400 hover:text-white hover:border-white/[0.15] active:scale-[0.97] transition-all cursor-pointer"
            >
              Ver en GitHub
            </a>
          </div>
        </div>

        {/* ── Terminal ── */}
        <div class="w-full max-w-xl mx-auto mt-14 sm:mt-16 md:mt-20">
          <div class="rounded-xl border border-white/[0.06] bg-[#111111] overflow-hidden">
            
            {/* Window chrome */}
            <div class="flex items-center gap-1.5 px-4 py-3 border-b border-white/[0.04]">
              <span class="h-[10px] w-[10px] rounded-full bg-white/[0.06]"></span>
              <span class="h-[10px] w-[10px] rounded-full bg-white/[0.06]"></span>
              <span class="h-[10px] w-[10px] rounded-full bg-white/[0.06]"></span>
              <span class="ml-auto text-[10px] text-zinc-600 font-mono">cvforge-ats v1.0</span>
            </div>

            {/* Terminal body */}
            <pre 
              id="terminal-content" 
              class="h-48 sm:h-52 md:h-56 overflow-y-auto px-4 py-3 leading-[1.7] whitespace-pre-wrap font-mono text-[11px] sm:text-[12px] text-zinc-500 scrollbar-none"
            ></pre>
          </div>
        </div>
      </main>

      {/* ── Footer ── */}
      <footer class="py-6 flex items-center justify-between text-[12px] text-zinc-600 shrink-0 border-t border-white/[0.04]">
        <span>© 2026 CVForge</span>
        <div class="flex items-center gap-5">
          <a href="/login" class="hover:text-zinc-300 transition-colors duration-150">Acceso</a>
          <a href="/register" class="hover:text-zinc-300 transition-colors duration-150">Registro</a>
        </div>
      </footer>
    </div>
  </div>

  <script>
    // ── Terminal animation ──
    const lines = [
      "$ cvforge scan --file resume.pdf",
      "",
      "  Conectando a base de datos...",
      "  Motor ATS inicializado.",
      "",
      "  Escaneando campos del perfil:",
      "    ✓ Información personal",
      "    ✓ Educación",
      "    ✓ Habilidades técnicas",
      "    ✓ Experiencia laboral",
      "",
      "  Validando estructura...",
      "    ✓ Resumen profesional detectado",
      "    ✓ Formato compatible con ATS",
      "",
      "  Analizando keywords...",
      "    ████████████████████ 100%",
      "",
      "  ┌───────────────────────────┐",
      "  │  Compatibilidad ATS: 98%  │",
      "  │  Estado: Aprobado ✓       │",
      "  └───────────────────────────┘",
      "",
      "  Listo. Redirigiendo al editor..."
    ];

    const pre = document.getElementById('terminal-content');
    let idx = 0;

    function typeLine() {
      if (!pre) return;
      if (idx < lines.length) {
        const line = lines[idx];
        pre.textContent += line + '\n';
        idx++;
        pre.scrollTop = pre.scrollHeight;

        const d = line === "" ? 80
          : line.startsWith("$") ? 500
          : line.startsWith("    ✓") ? 180
          : line.includes("████") ? 400
          : line.startsWith("  ┌") || line.startsWith("  └") ? 300
          : 200;

        setTimeout(typeLine, d);
      } else {
        setTimeout(() => { pre.textContent = ""; idx = 0; typeLine(); }, 7000);
      }
    }
    setTimeout(typeLine, 600);

    // ── Mobile nav ──
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('mobile-nav');
    let open = false;

    if (btn && nav) {
      btn.addEventListener('click', () => {
        open = !open;
        const bars = btn.querySelectorAll('.hamburger-line');
        if (open) {
          nav.style.maxHeight = nav.scrollHeight + 'px';
          nav.style.opacity = '1';
          if (bars[0]) { bars[0].style.transform = 'translateY(3.5px) rotate(45deg)'; }
          if (bars[1]) { bars[1].style.transform = 'translateY(-3.5px) rotate(-45deg)'; }
        } else {
          nav.style.maxHeight = '0';
          nav.style.opacity = '0';
          if (bars[0]) { bars[0].style.transform = ''; }
          if (bars[1]) { bars[1].style.transform = ''; }
        }
      });

      nav.querySelectorAll('.mobile-nav-link').forEach(a => {
        a.addEventListener('click', () => {
          open = false;
          nav.style.maxHeight = '0';
          nav.style.opacity = '0';
          const bars = btn.querySelectorAll('.hamburger-line');
          if (bars[0]) { bars[0].style.transform = ''; }
          if (bars[1]) { bars[1].style.transform = ''; }
        });
      });
    }
  </script>

  <style is:global>
    .scrollbar-none::-webkit-scrollbar { display: none; }
    .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

    .landing a, .landing button { -webkit-tap-highlight-color: transparent; }
    .landing { -webkit-overflow-scrolling: touch; }
  </style>
</Layout>
