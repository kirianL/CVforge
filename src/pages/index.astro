---
import Layout from '../layouts/Layout.astro';
import { getUserFromRequest } from '../lib/auth';

const user = await getUserFromRequest(Astro.request);
---

<Layout 
  title="CVForge | Generador de Currículums Optimizado para ATS"
  description="Crea un currículum profesional de una sola página, optimizado para pasar los filtros automáticos ATS de reclutamiento y exportable a PDF de forma gratuita."
>
  <div class="landing min-h-screen bg-zinc-55/30 text-zinc-900 flex flex-col font-sans relative overflow-hidden">

    {/* ── Subtle noise texture ── */}
    <div class="absolute inset-0 opacity-[0.012] pointer-events-none" style="background-image:url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E')"></div>

    {/* ── Soft radial vignette ── */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(120,119,198,0.03),transparent)] pointer-events-none"></div>

    {/* ══════════ Content shell ══════════ */}
    <div class="mx-auto w-full max-w-[1120px] px-5 sm:px-8 flex flex-col min-h-screen relative z-10">

      {/* ── Header ── */}
      <header class="flex h-14 items-center justify-between shrink-0 py-4">
        <a href="/" class="flex items-center gap-2 no-underline">
          <span class="text-[15px] font-extrabold tracking-tight text-zinc-900">CVForge</span>
        </a>

        {/* Desktop nav */}
        <nav class="hidden md:flex items-center gap-6 text-[13px] text-zinc-550 font-medium">
          <a href="#features" class="hover:text-black transition-colors duration-150">Características</a>
          <a href="#editor" class="hover:text-black transition-colors duration-150">Editor</a>
          <a href="https://github.com/kirianL/CVforge" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors duration-150">GitHub</a>
        </nav>

        <div class="flex items-center gap-3">
          {user ? (
            <>
              <span class="text-[13px] text-zinc-500 hidden sm:inline">Hola, {user.name}</span>
              <a 
                href="/dashboard" 
                class="inline-flex h-8 items-center justify-center rounded-lg bg-black px-3.5 text-[13px] font-semibold text-white hover:bg-zinc-800 active:scale-[0.97] transition-all cursor-pointer shadow-sm"
              >
                Dashboard
              </a>
            </>
          ) : (
            <>
              <a href="/login" class="hidden sm:inline text-[13px] text-zinc-550 hover:text-black transition-colors duration-150 font-semibold">
                Entrar
              </a>
              <a 
                href="/register" 
                class="inline-flex h-8 items-center justify-center rounded-lg bg-black px-3.5 text-[13px] font-semibold text-white hover:bg-zinc-800 active:scale-[0.97] transition-all cursor-pointer shadow-sm"
              >
                Comenzar
              </a>
            </>
          )}

          {/* Mobile menu */}
          <button 
            id="mobile-menu-btn"
            type="button"
            class="md:hidden flex flex-col items-center justify-center w-8 h-8 gap-[5px] rounded-md hover:bg-zinc-100 transition-colors cursor-pointer"
            aria-label="Abrir menú"
          >
            <span class="hamburger-line block w-[18px] h-[1.5px] bg-zinc-600 rounded-full transition-all duration-300 origin-center"></span>
            <span class="hamburger-line block w-[18px] h-[1.5px] bg-zinc-600 rounded-full transition-all duration-300 origin-center"></span>
          </button>
        </div>
      </header>

      {/* Thin separator */}
      <div class="h-px bg-zinc-200/60"></div>

      {/* ── Mobile nav drawer ── */}
      <div id="mobile-nav" class="md:hidden overflow-hidden transition-all duration-300 ease-out" style="max-height:0;opacity:0">
        <nav class="flex flex-col py-3 border-b border-zinc-200/60">
          <a href="#features" class="mobile-nav-link px-2 py-2.5 text-[14px] text-zinc-500 hover:text-black transition-colors duration-150 font-medium">Características</a>
          <a href="#editor" class="mobile-nav-link px-2 py-2.5 text-[14px] text-zinc-500 hover:text-black transition-colors duration-150 font-medium">Editor</a>
          <a href="https://github.com/kirianL/CVforge" target="_blank" rel="noopener noreferrer" class="mobile-nav-link px-2 py-2.5 text-[14px] text-zinc-500 hover:text-black transition-colors duration-150 font-medium">GitHub</a>
          {!user && (
            <a href="/login" class="mobile-nav-link px-2 py-2.5 text-[14px] text-zinc-500 hover:text-black transition-colors duration-150 font-medium">Iniciar sesión</a>
          )}
        </nav>
      </div>

      {/* ══════════ Hero (Split Screen) ══════════ */}
      <main class="flex-1 flex flex-col lg:flex-row items-center justify-between py-12 lg:py-20 gap-12 lg:gap-8">
        
        {/* Left Side: Copywriting */}
        <div class="w-full lg:max-w-xl text-center lg:text-left space-y-6 sm:space-y-8">
          {/* Headline */}
          <h1 class="text-[2.25rem] sm:text-[3.25rem] md:text-[3.75rem] lg:text-[4.25rem] font-semibold leading-[1.08] tracking-[-0.03em] text-zinc-900">
            Crea currículos que <br class="hidden sm:inline"/>
            <span class="text-zinc-400">superan filtros ATS.</span>
          </h1>

          {/* Subtitle */}
          <p class="text-[15px] sm:text-[17px] leading-relaxed text-zinc-550 max-w-lg mx-auto lg:mx-0">
            Editor en tiempo real, formato profesional validado por reclutadores y exportación PDF gratuita. Minimalista, estético y en blanco.
          </p>

          {/* CTA row */}
          <div class="flex flex-col sm:flex-row gap-3 items-center justify-center lg:justify-start pt-2">
            <a 
              href={user ? "/dashboard" : "/register"} 
              class="w-full sm:w-auto inline-flex h-10 sm:h-11 items-center justify-center rounded-lg bg-black px-5 sm:px-6 text-[14px] font-semibold text-white hover:bg-zinc-800 active:scale-[0.97] transition-all cursor-pointer shadow-md"
            >
              Comenzar gratis →
            </a>
            <a 
              href="https://github.com/kirianL/CVforge"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex h-10 sm:h-11 items-center justify-center rounded-lg border border-zinc-200 bg-white px-5 sm:px-6 text-[14px] font-medium text-zinc-650 hover:bg-zinc-50 hover:border-zinc-350 active:scale-[0.97] transition-all cursor-pointer shadow-sm"
            >
              Ver en GitHub
            </a>
          </div>
        </div>

        {/* Right Side: Imposing Floating 3D ASCII Temple Facade */}
        <div class="w-full lg:w-1/2 flex justify-center items-center lg:justify-end overflow-hidden">
          <pre 
            id="ascii-sculpture" 
            class="leading-[0.92] font-mono text-[7px] sm:text-[8px] md:text-[9px] lg:text-[9.5px] xl:text-[10px] text-zinc-850 select-none cursor-default font-extrabold transition-colors hover:text-black"
          ></pre>
        </div>
      </main>

      {/* ── Footer ── */}
      <footer class="py-6 flex items-center justify-between text-[12px] text-zinc-500 shrink-0 border-t border-zinc-200/60">
        <span>© 2026 CVForge</span>
        <div class="flex items-center gap-5">
          <a href="/login" class="hover:text-black transition-colors duration-150 font-medium">Acceso</a>
          <a href="/register" class="hover:text-black transition-colors duration-150 font-medium">Registro</a>
        </div>
      </footer>
    </div>
  </div>

  <script>
    // ── 3D ASCII Temple Facade Rendering ──
    const asciiElement = document.getElementById('ascii-sculpture');
    const ramp = " .:-=+*#%@";

    let A = 0.12; // Slight X tilt for perspective
    let B = 0;    // Y rotation angle (slow)

    const width = 80;
    const height = 44;

    function renderFrame() {
      if (!asciiElement) return;

      const output = Array(width * height).fill(' ');
      const zbuffer = Array(width * height).fill(-1000);

      // Helper function to project and draw a 3D point into the ASCII buffer
      function drawPoint(x3, y3, z3, nx3, ny3, nz3) {
        // Rotate around Y axis (angle B)
        const xRotY = x3 * Math.cos(B) - z3 * Math.sin(B);
        const zRotY = x3 * Math.sin(B) + z3 * Math.cos(B);

        // Rotate normal around Y axis
        const nxRotY = nx3 * Math.cos(B) - nz3 * Math.sin(B);
        const nzRotY = nx3 * Math.sin(B) + nz3 * Math.cos(B);

        // Rotate around X axis (angle A)
        const yFinal = y3 * Math.cos(A) - zRotY * Math.sin(A);
        const zFinal = y3 * Math.sin(A) + zRotY * Math.cos(A);

        const nyFinal = ny3 * Math.cos(A) - nzRotY * Math.sin(A);
        const nzFinalNormal = ny3 * Math.sin(A) + nzRotY * Math.cos(A);

        const distance = 25;
        const scaleX = 2.45;
        const scaleY = 1.1;

        const ooz = 1 / (zFinal + distance);
        const xp = Math.round(width / 2 + scaleX * xRotY * ooz * 32);
        const yp = Math.round(height / 2 - scaleY * yFinal * ooz * 36);

        if (xp >= 0 && xp < width && yp >= 0 && yp < height) {
          // Standard front-top-left directional light
          const luminance = nxRotY * 0.4 + nyFinal * 0.3 - nzFinalNormal * 0.85;

          if (ooz > zbuffer[yp * width + xp]) {
            zbuffer[yp * width + xp] = ooz;

            let charIdx = Math.floor((luminance + 1) * 4.5);
            charIdx = Math.max(0, Math.min(ramp.length - 1, charIdx));
            output[yp * width + xp] = ramp[charIdx];
          }
        }
      }

      // Draw a 3D box/cuboid face system
      function drawBox(xMin, xMax, yMin, yMax, zMin, zMax) {
        // Front and Back
        for (let x = xMin; x <= xMax; x += 0.35) {
          for (let y = yMin; y <= yMax; y += 0.25) {
            drawPoint(x, y, zMin, 0, 0, -1);
            drawPoint(x, y, zMax, 0, 0, 1);
          }
        }
        // Left and Right
        for (let z = zMin; z <= zMax; z += 0.35) {
          for (let y = yMin; y <= yMax; y += 0.25) {
            drawPoint(xMin, y, z, -1, 0, 0);
            drawPoint(xMax, y, z, 1, 0, 0);
          }
        }
        // Top and Bottom
        for (let x = xMin; x <= xMax; x += 0.35) {
          for (let z = zMin; z <= zMax; z += 0.35) {
            drawPoint(x, yMin, z, 0, -1, 0);
            drawPoint(x, yMax, z, 0, 1, 0);
          }
        }
      }

      // 1. STEPPED BASE (Stylobate)
      drawBox(-7.2, 7.2, 5.0, 5.5, -3.2, 3.2); // Step 1
      drawBox(-7.6, 7.6, 5.5, 6.0, -3.6, 3.6); // Step 2
      drawBox(-8.0, 8.0, 6.0, 6.6, -4.0, 4.0); // Step 3

      // 2. ARCHITRAVE (Horizontal lintel above columns)
      drawBox(-7.6, 7.6, -5.2, -4.2, -3.2, 3.2);

      // 3. PEDIMENT (Triangular Greek Roof)
      for (let y = -7.0; y <= -5.2; y += 0.22) {
        // w is the half-width decreasing linearly to form the triangle
        const w = 7.6 * (1 - (y + 5.2) / -1.8);
        // Front & back triangle walls
        for (let x = -w; x <= w; x += 0.3) {
          drawPoint(x, y, -3.2, 0, 0, -1);
          drawPoint(x, y, 3.2, 0, 0, 1);
        }
      }
      // Roof slopes
      for (let z = -3.2; z <= 3.2; z += 0.3) {
        for (let y = -7.0; y <= -5.2; y += 0.2) {
          const w = 7.6 * (1 - (y + 5.2) / -1.8);
          drawPoint(-w, y, z, -0.9, -0.4, 0); // Left slope
          drawPoint(w, y, z, 0.9, -0.4, 0);  // Right slope
        }
      }

      // 4. FOUR COLUMNS
      const colX = [-5.2, -1.7, 1.7, 5.2];
      for (let c = 0; c < colX.length; c++) {
        const cx = colX[c];

        // Column cylinder shaft with vertical grooves
        for (let y = -4.2; y <= 5.0; y += 0.22) {
          for (let theta = 0; theta < 2 * Math.PI; theta += 0.15) {
            const numGrooves = 8;
            const grooveDepth = 0.12;
            const R = 0.75 + grooveDepth * Math.cos(numGrooves * theta);

            const x = cx + Math.cos(theta) * R;
            const z = Math.sin(theta) * R;
            drawPoint(x, y, z, Math.cos(theta), 0, Math.sin(theta));
          }
        }

        // Capitals & Bases for each column
        for (let r = 0; r <= 0.95; r += 0.15) {
          for (let theta = 0; theta < 2 * Math.PI; theta += 0.2) {
            drawPoint(cx + Math.cos(theta) * r, -4.25, Math.sin(theta) * r, 0, -1, 0); // Capital cap
            drawPoint(cx + Math.cos(theta) * r, 5.05, Math.sin(theta) * r, 0, 1, 0);  // Base cap
          }
        }
      }

      // Render output to screen
      let frameStr = '';
      for (let h = 0; h < height; h++) {
        for (let w = 0; w < width; w++) {
          frameStr += output[h * width + w];
        }
        frameStr += '\n';
      }

      asciiElement.textContent = frameStr;
      
      // Slow rotation for majestic, premium, and imposing look
      B += 0.008; 
    }

    // Run render ticks
    setInterval(renderFrame, 45);

    // ── Mobile nav ──
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('mobile-nav');
    let open = false;

    if (btn && nav) {
      btn.addEventListener('click', () => {
        open = !open;
        const bars = btn.querySelectorAll('.hamburger-line');
        if (open) {
          nav.style.maxHeight = nav.scrollHeight + 'px';
          nav.style.opacity = '1';
          if (bars[0]) { bars[0].style.transform = 'translateY(3.5px) rotate(45deg)'; }
          if (bars[1]) { bars[1].style.transform = 'translateY(-3.5px) rotate(-45deg)'; }
        } else {
          nav.style.maxHeight = '0';
          nav.style.opacity = '0';
          if (bars[0]) { bars[0].style.transform = ''; }
          if (bars[1]) { bars[1].style.transform = ''; }
        }
      });

      nav.querySelectorAll('.mobile-nav-link').forEach(a => {
        a.addEventListener('click', () => {
          open = false;
          nav.style.maxHeight = '0';
          nav.style.opacity = '0';
          const bars = btn.querySelectorAll('.hamburger-line');
          if (bars[0]) { bars[0].style.transform = ''; }
          if (bars[1]) { bars[1].style.transform = ''; }
        });
      });
    }
  </script>

  <style is:global>
    .scrollbar-none::-webkit-scrollbar { display: none; }
    .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

    .landing a, .landing button { -webkit-tap-highlight-color: transparent; }
    .landing { -webkit-overflow-scrolling: touch; }
  </style>
</Layout>
