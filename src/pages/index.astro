  <script>
    // ── SPA View Switcher with Dynamic Height & Directional Slide ──
    const viewHero = document.getElementById('view-hero');
    const viewFeatures = document.getElementById('view-features');
    const viewLogin = document.getElementById('view-login');
    const viewRegister = document.getElementById('view-register');
    const viewsContainer = document.getElementById('views-container');

    const viewDepths = {
      hero: 0,
      features: 1,
      login: 2,
      register: 3
    };

    let isTransitioning = false;
    type ViewName = 'hero' | 'features' | 'login' | 'register';
    let currentActiveViewName: ViewName = 'hero';

    function switchView(target: ViewName) {
      if (isTransitioning || target === currentActiveViewName) return;

      const prevViewName = currentActiveViewName;
      currentActiveViewName = target;
      isTransitioning = true;

      const viewsMap = {
        hero: viewHero,
        features: viewFeatures,
        login: viewLogin,
        register: viewRegister
      };

      const activeEl = viewsMap[prevViewName];
      const nextEl = viewsMap[target];

      if (!activeEl || !nextEl || !viewsContainer) {
        isTransitioning = false;
        return;
      }

      const isForward = viewDepths[target] > viewDepths[prevViewName];

      // 1. Measure current container height
      const prevHeight = viewsContainer.offsetHeight;

      // 2. Lock container height to prevent screen bouncing
      viewsContainer.style.height = prevHeight + 'px';

      // 3. Prepare the next view (make it display:flex, but invisible and offset)
      nextEl.classList.remove('hidden');
      nextEl.classList.add('pointer-events-none');
      
      // Position offscreen based on direction
      nextEl.classList.remove('opacity-100', 'translate-x-0', 'view-active');
      nextEl.classList.add('opacity-0');
      if (isForward) {
        nextEl.classList.remove('-translate-x-12');
        nextEl.classList.add('translate-x-12');
      } else {
        nextEl.classList.remove('translate-x-12');
        nextEl.classList.add('-translate-x-12');
      }

      // Force DOM reflow to apply starting transition values
      nextEl.offsetHeight;

      // 4. Measure target container height with the new view loaded
      const targetHeight = nextEl.offsetHeight;

      // 5. Animate container height to target height
      viewsContainer.style.height = targetHeight + 'px';

      // 6. Slide and fade active element out
      activeEl.classList.remove('opacity-100', 'translate-x-0', 'view-active');
      activeEl.classList.add('opacity-0', 'pointer-events-none');
      if (isForward) {
        activeEl.classList.add('-translate-x-12');
      } else {
        activeEl.classList.add('translate-x-12');
      }

      // 7. Slide and fade target element in
      nextEl.classList.remove('opacity-0', 'translate-x-12', '-translate-x-12');
      nextEl.classList.add('opacity-100', 'translate-x-0', 'view-active');

      // 8. Clean up after the transition finishes (500ms)
      setTimeout(() => {
        activeEl.classList.add('hidden');
        activeEl.classList.remove('pointer-events-none', 'translate-x-12', '-translate-x-12');
        
        nextEl.classList.remove('pointer-events-none');
        viewsContainer.style.height = ''; // Clear height constraint for responsiveness
        isTransitioning = false;
      }, 500);
    }

    // Trigger initial load animation for the Hero
    if (viewHero) {
      requestAnimationFrame(() => {
        viewHero.classList.add('view-active');
        viewHero.classList.remove('opacity-0');
      });
    }

    // Read logged in status
    const isLoggedIn = document.getElementById('landing-header')?.dataset.loggedIn === 'true';

    // Register DOM listeners for View Switches
    document.getElementById('nav-login-btn')?.addEventListener('click', () => switchView('login'));
    document.getElementById('nav-register-btn')?.addEventListener('click', () => switchView('register'));
    
    // Características navigation
    const handleFeaturesClick = (e: Event) => {
      e.preventDefault();
      switchView('features');
    };
    document.getElementById('nav-features-link')?.addEventListener('click', handleFeaturesClick);
    document.getElementById('mobile-features-link')?.addEventListener('click', (e) => {
      handleFeaturesClick(e);
      document.getElementById('mobile-menu-btn')?.click();
    });
    document.getElementById('features-back-btn')?.addEventListener('click', () => switchView('hero'));

    // Editor navigation (If logged in -> dashboard, if logged out -> login)
    const handleEditorClick = (e: Event) => {
      e.preventDefault();
      if (isLoggedIn) {
        window.location.href = '/dashboard';
      } else {
        switchView('login');
      }
    };
    document.getElementById('nav-editor-link')?.addEventListener('click', handleEditorClick);
    document.getElementById('mobile-editor-link')?.addEventListener('click', (e) => {
      handleEditorClick(e);
      document.getElementById('mobile-menu-btn')?.click();
    });

    document.getElementById('mobile-login-btn')?.addEventListener('click', () => {
      switchView('login');
      document.getElementById('mobile-menu-btn')?.click();
    });
    document.getElementById('mobile-register-btn')?.addEventListener('click', () => {
      switchView('register');
      document.getElementById('mobile-menu-btn')?.click();
    });
    
    document.getElementById('logo-home-btn')?.addEventListener('click', () => switchView('hero'));
    document.getElementById('hero-start-btn')?.addEventListener('click', () => switchView('register'));

    document.getElementById('login-back-btn')?.addEventListener('click', () => switchView('hero'));
    document.getElementById('login-to-register-btn')?.addEventListener('click', () => switchView('register'));

    document.getElementById('register-back-btn')?.addEventListener('click', () => switchView('hero'));
    document.getElementById('register-to-login-btn')?.addEventListener('click', () => switchView('login'));

    document.getElementById('footer-login-btn')?.addEventListener('click', () => switchView('login'));
    document.getElementById('footer-register-btn')?.addEventListener('click', () => switchView('register'));

    // Check URL flow on load
    const params = new URLSearchParams(window.location.search);
    const flow = params.get('flow');
    if (flow === 'login') {
      switchView('login');
    } else if (flow === 'register') {
      switchView('register');
    }

    // ── Login Submit API Call ──
    const loginForm = document.getElementById('login-form') as HTMLFormElement;
    const loginError = document.getElementById('login-error-alert') as HTMLDivElement;
    const loginSubmit = document.getElementById('login-submit-btn') as HTMLButtonElement;

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('login-email') as HTMLInputElement).value;
      const password = (document.getElementById('login-password') as HTMLInputElement).value;

      loginError.classList.add('hidden');
      loginSubmit.disabled = true;
      loginSubmit.innerText = 'Cargando...';

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error al iniciar sesión');
        
        loginSubmit.innerText = '✓ Conectado';
        loginSubmit.classList.remove('bg-black', 'hover:bg-zinc-800');
        loginSubmit.classList.add('bg-emerald-600', 'hover:bg-emerald-600');
        
        const landing = document.querySelector('.landing');
        if (landing) {
          landing.classList.add('transition-all', 'duration-500', 'ease-in-out', 'opacity-0', 'scale-[0.985]');
        }
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 500);
      } catch (err: any) {
        loginError.innerText = err.message;
        loginError.classList.remove('hidden');
        loginSubmit.disabled = false;
        loginSubmit.innerText = 'Iniciar Sesión';
      }
    });

    // ── Register Submit API Call ──
    const regForm = document.getElementById('register-form') as HTMLFormElement;
    const regError = document.getElementById('register-error-alert') as HTMLDivElement;
    const regSubmit = document.getElementById('register-submit-btn') as HTMLButtonElement;

    regForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('register-name') as HTMLInputElement).value;
      const email = (document.getElementById('register-email') as HTMLInputElement).value;
      const password = (document.getElementById('register-password') as HTMLInputElement).value;

      regError.classList.add('hidden');
      regSubmit.disabled = true;
      regSubmit.innerText = 'Cargando...';

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, password }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error al crear la cuenta');
        
        regSubmit.innerText = '✓ Cuenta Creada';
        regSubmit.classList.remove('bg-black', 'hover:bg-zinc-800');
        regSubmit.classList.add('bg-emerald-600', 'hover:bg-emerald-600');
        
        const landing = document.querySelector('.landing');
        if (landing) {
          landing.classList.add('transition-all', 'duration-500', 'ease-in-out', 'opacity-0', 'scale-[0.985]');
        }
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 500);
      } catch (err: any) {
        regError.innerText = err.message;
        regError.classList.remove('hidden');
        regSubmit.disabled = false;
        regSubmit.innerText = 'Crear Cuenta';
      }
    });

    // ── Mobile nav toggle logic ──
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('mobile-nav');
    let open = false;

    if (btn && nav) {
      btn.addEventListener('click', () => {
        open = !open;
        const bars = btn.querySelectorAll('.hamburger-line');
        if (open) {
          nav.style.maxHeight = nav.scrollHeight + 'px';
          nav.style.opacity = '1';
          if (bars[0]) { bars[0].style.transform = 'translateY(3.5px) rotate(45deg)'; }
          if (bars[1]) { bars[1].style.transform = 'translateY(-3.5px) rotate(-45deg)'; }
        } else {
          nav.style.maxHeight = '0';
          nav.style.opacity = '0';
          if (bars[0]) { bars[0].style.transform = ''; }
          if (bars[1]) { bars[1].style.transform = ''; }
        }
      });

      nav.querySelectorAll('.mobile-nav-link').forEach(a => {
        a.addEventListener('click', () => {
          open = false;
          nav.style.maxHeight = '0';
          nav.style.opacity = '0';
          const bars = btn.querySelectorAll('.hamburger-line');
          if (bars[0]) { bars[0].style.transform = ''; }
          if (bars[1]) { bars[1].style.transform = ''; }
        });
      });
    }
  </script>

  <style is:global>
    .scrollbar-none::-webkit-scrollbar { display: none; }
    .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

    .landing a, .landing button { -webkit-tap-highlight-color: transparent; }
    .landing { -webkit-overflow-scrolling: touch; }

    /* Native scrolling on mobile handles viewports and virtual keyboards cleanly */

    /* Motion text reveal keyframes */
    @keyframes revealUp {
      from {
        transform: translateY(100%);
      }
      to {
        transform: translateY(0);
      }
    }

    .reveal-text {
      animation: revealUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animation-delay-150 {
      animation-delay: 0.15s;
    }

    /* Staggered form field reveal transition on view active */
    .reveal-item {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .view-active .reveal-item {
      opacity: 1;
      transform: translateY(0);
    }

    .delay-0 { transition-delay: 0ms !important; }
    .delay-75 { transition-delay: 75ms !important; }
    .delay-150 { transition-delay: 150ms !important; }
    .delay-225 { transition-delay: 225ms !important; }
    .delay-300 { transition-delay: 300ms !important; }
    .delay-375 { transition-delay: 375ms !important; }
    .delay-450 { transition-delay: 450ms !important; }
    .delay-525 { transition-delay: 525ms !important; }

    /* SPA Page Transitions Optimization */
    #views-container {
      will-change: height;
    }

    #view-hero, #view-features, #view-login, #view-register {
      will-change: transform, opacity;
    }

    /* Perspective and Tilt for 3D A4 Mockup */
    .perspective-container {
      perspective: 1200px;
    }

    .tilted-document {
      transform: rotateY(-14deg) rotateX(10deg) rotateZ(-2deg);
      box-shadow: 
        -10px 10px 30px rgba(0, 0, 0, 0.02),
        -20px 20px 50px rgba(0, 0, 0, 0.04),
        1px 1px 1px rgba(255, 255, 255, 0.8) inset;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
      will-change: transform, box-shadow;
    }

    .tilted-document:hover {
      transform: rotateY(-6deg) rotateX(6deg) rotateZ(-1deg) translateY(-6px);
      box-shadow: 
        -15px 15px 40px rgba(0, 0, 0, 0.04),
        -30px 30px 70px rgba(0, 0, 0, 0.06);
    }

    /* Laser Scanner Beam Animation (GPU Compositor Accelerated) */
    @keyframes scan {
      0% {
        transform: translateY(30px);
        opacity: 0.1;
      }
      15% {
        opacity: 1;
      }
      85% {
        opacity: 1;
      }
      100% {
        transform: translateY(440px);
        opacity: 0.1;
      }
    }

    .scanner-beam {
      top: 0;
      transform: translateY(30px);
      animation: scan 4.5s ease-in-out infinite alternate;
      will-change: transform, opacity;
    }

    /* Floating Animations for metrics and badges */
    @keyframes float {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-8px);
      }
    }

    .floating-card {
      animation: float 5s ease-in-out infinite;
      will-change: transform;
    }

    .floating-card-delay-1 {
      animation: float 6s ease-in-out infinite;
      animation-delay: 0.5s;
      will-change: transform;
    }

    .floating-card-delay-2 {
      animation: float 5.5s ease-in-out infinite;
      animation-delay: 1.2s;
      will-change: transform;
    }

    .floating-card-delay-3 {
      animation: float 6.5s ease-in-out infinite;
      animation-delay: 1.8s;
      will-change: transform;
    }
  </style>
</Layout>
