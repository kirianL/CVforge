---
import Layout from '../layouts/Layout.astro';
import { getUserFromRequest } from '../lib/auth';

const user = await getUserFromRequest(Astro.request);
---

<Layout 
  title="CVForge | Generador de Currículums Optimizado para ATS"
  description="Crea un currículum profesional de una sola página, optimizado para pasar los filtros automáticos ATS de reclutamiento y exportable a PDF."
>
  <div class="min-h-screen bg-zinc-100 dark:bg-zinc-950 p-4 md:p-6 flex flex-col justify-center transition-colors">
    {/* Modern SaaS Container (App Shell) */}
    <div class="mx-auto w-full max-w-7xl rounded-[32px] bg-[#829ab1] dark:bg-[#1a2332] text-white overflow-hidden shadow-2xl p-6 md:p-8 flex flex-col justify-between min-h-[92vh] relative select-none">
      
      {/* Background Micro-details */}
      <div class="absolute inset-0 bg-radial-gradient from-white/5 to-transparent pointer-events-none"></div>

      {/* Unified Header */}
      <header class="relative z-10 flex h-14 items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-white text-zinc-900 font-extrabold text-xl shadow">
            CF
          </div>
          <span class="text-xl font-bold tracking-tight text-white">CV<span class="opacity-70">Forge</span></span>
        </div>

        {/* Minimal Nav Links */}
        <nav class="hidden md:flex items-center gap-8 text-xs font-bold uppercase tracking-wider text-white/80">
          <a href="#features" class="hover:text-white transition-colors">Características</a>
          <a href="#editor" class="hover:text-white transition-colors">Editor</a>
          <a href="https://github.com/kirianL/CVforge" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
        </nav>

        {/* Auth Actions */}
        <div class="flex items-center gap-4">
          {user ? (
            <>
              <span class="text-xs font-bold opacity-80 hidden sm:inline">Hola, {user.name}</span>
              <a 
                href="/dashboard" 
                class="inline-flex h-9 items-center justify-center rounded-full bg-black px-4 text-xs font-bold text-white hover:bg-zinc-800 transition-all shadow-md active:scale-95 cursor-pointer"
              >
                Ir al Panel
              </a>
            </>
          ) : (
            <>
              <a href="/login" class="text-xs font-bold text-white/90 hover:text-white transition-colors">
                Entrar
              </a>
              <a 
                href="/register" 
                class="inline-flex h-9 items-center justify-center rounded-full bg-white px-4 text-xs font-bold text-zinc-900 hover:bg-zinc-100 transition-all shadow-md active:scale-95 cursor-pointer"
              >
                Crear CV Gratis
              </a>
            </>
          )}
        </div>
      </header>

      {/* Main SaaS Hero Section */}
      <main class="relative z-10 my-auto py-10 flex flex-col lg:grid lg:grid-cols-12 gap-10 items-center">
        
        {/* Left Side: Pitch */}
        <div class="lg:col-span-6 text-center lg:text-left space-y-6 max-w-xl mx-auto lg:mx-0">
          {/* Badge */}
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-bold text-white/90 shadow-sm backdrop-blur-sm">
            <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            100% Compatible con Motores ATS
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight text-white">
            Currículums, <br class="hidden sm:inline" />
            <span class="opacity-80">no papeleo</span>
          </h1>

          <p class="text-sm sm:text-base leading-relaxed text-white/80 max-w-md mx-auto lg:mx-0 font-medium">
            Forja currículums profesionales instantáneos optimizados para pasar los filtros de contratación automáticos. Diseños validados por reclutadores, autoguardado en tiempo real y descarga en PDF 100% gratuita.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row gap-4 items-center justify-center lg:justify-start">
            <a 
              href={user ? "/dashboard" : "/register"} 
              class="w-full sm:w-auto inline-flex h-11 items-center justify-center rounded-full bg-black px-8 text-sm font-bold text-white shadow-lg hover:bg-zinc-800 hover:scale-[1.03] active:scale-95 transition-all dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100 cursor-pointer"
            >
              Comenzar gratis
            </a>
            <a 
              href="#features" 
              class="text-xs font-bold uppercase tracking-wider text-white/70 hover:text-white transition-colors py-2"
            >
              Ver características →
            </a>
          </div>
        </div>

        {/* Right Side: Animated ASCII Terminal Scanner */}
        <div class="lg:col-span-6 w-full max-w-lg mx-auto">
          <div class="rounded-2xl border border-white/10 bg-black/90 p-4 shadow-2xl text-left font-mono text-[10px] sm:text-xs text-emerald-400 select-none overflow-hidden relative">
            
            {/* Terminal Top Window Buttons */}
            <div class="flex items-center justify-between border-b border-zinc-800 pb-2.5 mb-3">
              <div class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-red-500/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green-500/80"></span>
              </div>
              <span class="text-[9px] text-zinc-500 font-bold tracking-wide">cvforge-ats-scanner v1.0.0</span>
              <div class="h-2.5 w-2.5"></div>
            </div>

            {/* Animating Code block */}
            <pre 
              id="terminal-content" 
              class="h-60 overflow-y-auto leading-normal whitespace-pre-wrap font-mono scrollbar-none pr-1"
            ></pre>

            {/* Pulsing scan bar overlay effect */}
            <div class="absolute inset-x-0 h-1/4 bg-emerald-500/5 pointer-events-none animate-scan"></div>
          </div>
        </div>
      </main>

      {/* Footer Block */}
      <footer class="relative z-10 border-t border-white/10 pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/70 font-semibold">
        <p>© 2026 CVForge. Todos los derechos reservados.</p>
        <div class="flex items-center gap-6">
          <a href="/login" class="hover:text-white transition-colors">Acceso</a>
          <a href="/register" class="hover:text-white transition-colors">Registro</a>
        </div>
      </footer>
    </div>
  </div>

  {/* Terminal animation script */}
  <script>
    const lines = [
      "[SYSTEM] Conectando a Neon Serverless PostgreSQL...",
      "[SYSTEM] Base de datos conectada correctamente.",
      "[SYSTEM] Inicializando motor de escaneo de filtros ATS...",
      "[SYSTEM] Cargando diccionario de palabras clave del sector IT...",
      "",
      ">> ESCANEANDO ARCHIVO: \"Kirian_Luna_CV_ATS.pdf\"",
      ">> Extrayendo campos estructurados del perfil...",
      "   ✓ Información personal (Nombre, Email, Teléfono, Ubicación)",
      "   ✓ Sección Educación (Bachillerato Ingeniería del Software)",
      "   ✓ Sección Habilidades (Astro, React, Zustand, Neon, Prisma)",
      "",
      ">> Validando longitud de perfil y descripciones de experiencia...",
      "   ✓ Resumen profesional: 184 caracteres (> 100 mínimo)",
      "   ✓ Puestos de trabajo: Descripciones con descripción de logros",
      "",
      ">> Analizando coincidencia de palabras clave automáticas...",
      "   [▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓] 100% COMPLETO",
      "",
      "----------------------------------------------------------",
      "|           REPORTE GENERAL DE COINCIDENCIA ATS          |",
      "|                                                        |",
      "|  ÍNDICE DE COMPATIBILIDAD:  [ 98% / 100% ]             |",
      "|  NIVEL DE OPTIMIZACIÓN:     EXCELENTE (APROBADO)        |",
      "|  RECOMENDACIÓN:             COMPLETAMENTE APTO         |",
      "----------------------------------------------------------",
      "",
      ">> ¡Listo! El currículum superará los filtros automáticos.",
      ">> Redirigiendo al usuario al panel de CVForge..."
    ];

    const pre = document.getElementById('terminal-content');
    let lineIdx = 0;

    function printNextLine() {
      if (!pre) return;
      if (lineIdx < lines.length) {
        pre.textContent += lines[lineIdx] + '\n';
        lineIdx++;
        // Auto scroll a la parte inferior
        pre.scrollTop = pre.scrollHeight;

        // Tiempos variables para dar sensación orgánica de carga
        const delay = lines[lineIdx - 1] === "" 
          ? 100 
          : lines[lineIdx - 1].startsWith("   ") 
          ? 150 
          : lines[lineIdx - 1].startsWith("---") 
          ? 350
          : 250;

        setTimeout(printNextLine, delay);
      } else {
        // Reiniciar animación después de 8 segundos
        setTimeout(() => {
          pre.textContent = "";
          lineIdx = 0;
          printNextLine();
        }, 8000);
      }
    }

    // Iniciar la animación al cargar
    setTimeout(printNextLine, 500);
  </script>

  <style is:global>
    /* Ocultar barra de scroll en terminal */
    .scrollbar-none::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-none {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Animación de barrido de radar de la terminal */
    @keyframes scan {
      0% {
        top: 0%;
      }
      50% {
        top: 75%;
      }
      100% {
        top: 0%;
      }
    }
    .animate-scan {
      animation: scan 6s linear infinite;
    }
  </style>
</Layout>
