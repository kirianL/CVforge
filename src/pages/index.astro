                  <div class="h-2 w-full bg-zinc-100 rounded-sm"></div>
                  <div class="h-2 w-[90%] bg-zinc-100 rounded-sm"></div>
                </div>
              </div>

              <div class="space-y-2">
                <div class="flex justify-between">
                  <div class="h-2 w-28 bg-zinc-300 rounded-sm"></div>
                  <div class="h-1.5 w-12 bg-zinc-200 rounded-sm"></div>
                </div>
                <div class="space-y-1">
                  <div class="h-2 w-full bg-zinc-100 rounded-sm"></div>
