---
import Layout from '../layouts/Layout.astro';
import { getUserFromRequest } from '../lib/auth';
import { getDb } from '../lib/db';

const user = await getUserFromRequest(Astro.request);

// Si no está autenticado, redirigir al login
if (!user) {
  return Astro.redirect('/login');
}

const prisma = getDb();
const resumes = await prisma.resume.findMany({
  where: { userId: user.id },
  orderBy: { updatedAt: 'desc' },
});

const gradients = [
  'from-violet-500 via-purple-500 to-pink-500',
  'from-cyan-500 via-blue-500 to-indigo-500',
  'from-amber-400 via-orange-500 to-pink-500',
  'from-emerald-400 via-teal-500 to-cyan-500',
  'from-rose-500 via-red-500 to-orange-500',
  'from-indigo-500 via-purple-600 to-fuchsia-500',
];
const getGradient = (id: string) => {
  let sum = 0;
  for (let i = 0; i < id.length; i++) {
    sum += id.charCodeAt(i);
  }
  return gradients[sum % gradients.length];
};
---

<Layout title="Panel de Control | CVForge">
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-950 select-none">
    
    <!-- Dashboard Header -->
    <header class="sticky top-0 z-40 w-full border-b border-zinc-200 bg-white/70 backdrop-blur-md dark:border-zinc-800/30 dark:bg-zinc-950/70 h-14 flex items-center">
      <div class="mx-auto w-full max-w-7xl flex h-14 items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2.5 no-underline cursor-pointer select-none" data-astro-prefetch>
          <div class="flex h-7.5 w-7.5 items-center justify-center rounded-lg bg-black text-white font-extrabold text-[15px] dark:bg-white dark:text-black">
            CF
          </div>
          <span class="text-[16px] font-bold tracking-tight text-zinc-900 dark:text-white">CV<span class="text-zinc-450">Forge</span></span>
        </a>

        <div class="flex items-center gap-4">
          <span class="hidden sm:inline text-sm text-zinc-650 dark:text-zinc-400 font-medium">Hola, {user.name}</span>
          <button 
            id="logout-btn"
            class="text-sm font-medium text-red-500 hover:text-red-650 transition-colors cursor-pointer"
          >
            Cerrar Sesión
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <!-- Welcome Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200 pb-5 dark:border-zinc-850">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Mis Currículums</h1>
          <p class="text-sm text-zinc-500 mt-1">Crea y gestiona tus currículums optimizados para ATS</p>
        </div>
        <button 
          id="new-cv-btn"
          class="inline-flex h-10 items-center justify-center rounded-md bg-black px-4 text-sm font-semibold text-white shadow hover:bg-zinc-800 active:scale-98 transition-all dark:bg-white dark:text-black dark:hover:bg-zinc-200 cursor-pointer"
        >
          + Crear Currículum
        </button>
      </div>

      <!-- Search and Filter Bar -->
      <div class="mt-6 flex flex-col sm:flex-row gap-4 items-center justify-between">
        <div class="relative w-full sm:max-w-xs">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
            <svg class="h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </span>
          <input 
            type="text" 
            id="search-input" 
            placeholder="Buscar currículum..." 
            class="flex h-10 w-full rounded-md border border-zinc-200 bg-white pl-9 pr-3 py-2 text-sm placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-black dark:border-zinc-800 dark:bg-zinc-900 dark:placeholder:text-zinc-650 dark:focus:ring-white"
          />
        </div>
        <span class="text-xs text-zinc-400 font-medium">
          {resumes.length} {resumes.length === 1 ? 'currículum registrado' : 'currículums registrados'}
        </span>
      </div>

      <!-- Resumes List -->
      <div class="mt-8">
        {resumes.length === 0 ? (
          <!-- Empty State -->
          <div class="flex flex-col items-center justify-center border-2 border-dashed border-zinc-250 rounded-xl p-16 text-center dark:border-zinc-800">
            <svg class="h-12 w-12 text-zinc-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
            <h3 class="text-lg font-bold">No tienes currículums aún</h3>
            <p class="text-sm text-zinc-500 mt-1 max-w-sm">Comienza creando tu primer hoja de vida optimizada para pasar los filtros automáticos de reclutamiento.</p>
            <button 
              id="new-cv-empty-btn"
              class="mt-4 inline-flex h-9 items-center justify-center rounded-md bg-zinc-900 px-4 text-xs font-semibold text-white shadow hover:bg-zinc-850 dark:bg-white dark:text-black dark:hover:bg-zinc-200 cursor-pointer"
            >
              Crear tu primer CV
            </button>
          </div>
        ) : (
          <!-- Empty Search State (Hidden initially) -->
          <div id="empty-search-state" class="hidden flex-col items-center justify-center border-2 border-dashed border-zinc-200 rounded-xl p-16 text-center dark:border-zinc-800">
            <svg class="h-12 w-12 text-zinc-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
            </svg>
            <h3 class="text-lg font-bold">No se encontraron currículums</h3>
            <p class="text-sm text-zinc-500 mt-1 max-w-sm">Prueba ajustando los términos de tu búsqueda.</p>
          </div>

          <!-- Resumes Grid -->
          <div id="resumes-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {resumes.map((resume) => (
              <div 
                key={resume.id}
                class="cv-card group relative flex flex-col justify-between p-6 bg-white border border-zinc-200/50 rounded-2xl hover:shadow-[0_8px_30px_rgb(0,0,0,0.03)] hover:border-zinc-300/80 transition-all duration-300 dark:bg-zinc-900/90 dark:border-zinc-800/40 dark:hover:border-zinc-700 dark:hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)]"
                id={`cv-card-${resume.id}`}
                data-title={resume.title}
              >
                {/* Accent top gradient bar */}
                <div class={`absolute top-0 left-0 right-0 h-1 group-hover:h-1.5 bg-gradient-to-r ${getGradient(resume.id)} rounded-t-2xl transition-all duration-300`} />
                {/* Soft glow on hover */}
                <div class={`absolute inset-0 -z-10 bg-gradient-to-r ${getGradient(resume.id)} opacity-0 group-hover:opacity-[0.05] blur-xl transition-all duration-300 rounded-2xl`} />

                <div>
                  {/* Top Action Row (Status & Dropdown Menu) */}
                  <div class="flex items-center justify-between gap-3 mb-4">
                    {/* Status Toggle Switch */}
                    <button 
                      class={`publish-toggle-btn text-[10px] font-semibold px-2.5 py-1 rounded-md border shadow-xs transition-all active:scale-95 cursor-pointer shrink-0 flex items-center gap-1.5 ${
                        resume.isPublished 
                          ? 'bg-emerald-50/80 text-emerald-700 border-emerald-200/60 dark:bg-emerald-950/20 dark:text-emerald-400 dark:border-emerald-900/30' 
                          : 'bg-zinc-100/70 text-zinc-650 border-zinc-200/60 dark:bg-zinc-800/40 dark:text-zinc-400 dark:border-zinc-800/20'
                      }`}
                      data-id={resume.id}
                      data-published={resume.isPublished ? "true" : "false"}
                      title={resume.isPublished ? 'Haz clic para despublicar' : 'Haz clic para publicar en la web'}
                    >
                      <span class={`h-1.5 w-1.5 rounded-full shrink-0 ${resume.isPublished ? 'bg-emerald-500 animate-pulse' : 'bg-zinc-450 dark:bg-zinc-500'}`}></span>
                      <span>{resume.isPublished ? 'Público' : 'Privado'}</span>
                    </button>

                    {/* Actions Dropdown Row (Rename, Duplicate, Delete) */}
                    <div class="flex items-center gap-1 opacity-20 md:opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-all duration-200">
                      <button 
                        class="rename-cv-btn p-1.5 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-50 text-zinc-500 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-850 dark:text-zinc-400 dark:hover:text-white cursor-pointer transition-all duration-200 hover:scale-[1.08] active:scale-[0.92] shadow-xs"
                        data-id={resume.id}
                        data-title={resume.title}
                        title="Renombrar currículum"
                      >
                        <svg viewBox="295 43 33 33" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path opacity="0.12" d="M297 70.5424C297 69.7271 297 69.3195 297.092 68.9359C297.174 68.5957 297.308 68.2706 297.491 67.9724C297.697 67.636 297.986 67.3477 298.562 66.7712L319.5 45.8333C320.881 44.4526 323.119 44.4526 324.5 45.8333C325.881 47.214 325.881 49.4526 324.5 50.8333L303.562 71.7712C302.986 72.3477 302.697 72.636 302.361 72.8421C302.063 73.0249 301.738 73.1596 301.397 73.2412C301.014 73.3333 300.606 73.3333 299.791 73.3333H297V70.5424Z" fill="currentColor"/>
                          <path d="M327 70L325.333 71.8234C324.449 72.7902 323.25 73.3333 322 73.3333C320.75 73.3333 319.551 72.7902 318.667 71.8234C317.782 70.8585 316.583 70.3168 315.334 70.3168C314.084 70.3168 312.885 70.8585 312 71.8234M297 73.3333H299.791C300.606 73.3333 301.014 73.3333 301.397 73.2412C301.738 73.1596 302.063 73.0249 302.361 72.8421C302.697 72.636 302.986 72.3477 303.562 71.7712L324.5 50.8333C325.881 49.4526 325.881 47.214 324.5 45.8333C323.119 44.4526 320.881 44.4526 319.5 45.8333L298.562 66.7712C297.986 67.3477 297.697 67.636 297.491 67.9724C297.308 68.2706 297.174 68.5957 297.092 68.9359C297 69.3195 297 69.7271 297 70.5424V73.3333Z" />
                        </svg>
                      </button>
                      <button 
                        class="duplicate-cv-btn p-1.5 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-50 text-zinc-500 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-850 dark:text-zinc-400 dark:hover:text-white cursor-pointer transition-all duration-200 hover:scale-[1.08] active:scale-[0.92] shadow-xs"
                        data-id={resume.id}
                        title="Duplicar currículum"
                      >
                        <svg viewBox="779 41 37 37" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path opacity="0.12" d="M793 60.3333C793 58.4665 793 57.5331 793.363 56.82C793.683 56.1928 794.193 55.6829 794.82 55.3633C795.533 55 796.466 55 798.333 55H809.333C811.2 55 812.134 55 812.847 55.3633C813.474 55.6829 813.984 56.1928 814.303 56.82C814.667 57.5331 814.667 58.4665 814.667 60.3333V71.3333C814.667 73.2002 814.667 74.1336 814.303 74.8466C813.984 75.4738 813.474 75.9838 812.847 76.3034C812.134 76.6667 811.2 76.6667 809.333 76.6667H798.333C796.466 76.6667 795.533 76.6667 794.82 76.3034C794.193 75.9838 793.683 75.4738 793.363 74.8466C793 74.1336 793 73.2002 793.363 74.8466C793.683 75.4738 794.193 75.9838 794.82 76.3034C795.533 76.6667 796.466 76.6667 798.333 76.6667Z" fill="currentColor"/>
                          <path d="M786.333 65C784.78 65 784.004 65 783.391 64.7463C782.574 64.408 781.925 63.759 781.587 62.9423C781.333 62.3297 781.333 61.5531 781.333 60V48.6667C781.333 46.7998 781.333 45.8664 781.697 45.1534C782.016 44.5262 782.526 44.0162 783.153 43.6966C783.866 43.3333 784.8 43.3333 786.667 43.3333H798C799.553 43.3333 800.33 43.3333 800.942 43.5871C801.759 43.9254 802.408 44.5743 802.746 45.3911C803 46.0036 803 46.7802 803 48.3333M798.333 76.6667H809.333C811.2 76.6667 812.134 76.6667 812.847 76.3034C813.474 75.9838 813.984 75.4738 814.303 74.8466C814.667 74.1336 814.667 73.2002 814.667 71.3333V60.3333C814.667 58.4665 814.667 57.5331 814.303 56.82C813.984 56.1928 813.474 55.6829 812.847 55.3633C812.134 55 811.2 55 809.333 55H798.333C796.466 55 795.533 55 794.82 55.3633C794.193 55.6829 793.683 56.1928 793.363 56.82C793 57.5331 793 58.4665 793 60.3333V71.3333C793 73.2002 793 74.1336 793.363 74.8466C793.683 75.4738 794.193 75.9838 794.82 76.3034C795.533 76.6667 796.466 76.6667 798.333 76.6667Z" />
                        </svg>
                      </button>
                      <button 
                        class="delete-cv-btn p-1.5 rounded-lg border border-zinc-200 bg-white hover:bg-red-50 hover:border-red-100 text-zinc-550 hover:text-red-650 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-red-950/20 dark:text-zinc-400 dark:hover:text-red-400 cursor-pointer transition-all duration-200 hover:scale-[1.08] active:scale-[0.92] shadow-xs"
                        data-id={resume.id}
                        title="Eliminar currículum"
                      >
                        <svg viewBox="619 41 34 37" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path opacity="0.12" d="M647.667 68.6667V50H624.333V68.6667C624.333 71.4669 624.333 72.8671 624.878 73.9366C625.358 74.8774 626.122 75.6423 627.063 76.1217C628.133 76.6667 629.533 76.6667 632.333 76.6667H639.667C642.467 76.6667 643.867 76.6667 644.937 76.1217C645.877 75.6423 646.642 74.8774 647.122 73.9366C647.667 72.8671 647.667 71.4669 647.667 68.6667Z" fill="currentColor"/>
                          <path d="M642.667 50V48.6667C642.667 46.7998 642.667 45.8664 642.303 45.1534C641.984 44.5262 641.474 44.0162 640.847 43.6966C640.134 43.3333 639.2 43.3333 637.333 43.3333H634.667C632.8 43.3333 631.866 43.3333 631.153 43.6966C630.526 44.0162 630.016 44.0162 629.697 45.1534C629.333 45.8664 629.333 46.7998 629.333 48.6667V50M632.667 59.1667V67.5M639.333 59.1667V67.5M621 50H651M647.667 50V68.6667C647.667 71.4669 647.667 72.8671 647.122 73.9366C646.642 74.8774 645.877 75.6423 644.937 76.1217C643.867 76.6667 642.467 76.6667 639.667 76.6667H632.333C629.533 76.6667 628.133 76.6667 627.063 76.1217C626.123 75.6423 625.358 74.8774 624.878 73.9366C624.333 72.8671 624.333 71.4669 624.333 68.6667V50" />
                        </svg>
                      </button>
                    </div>
                  </div>

                  {/* Card Title & Body */}
                  <div class="min-h-[58px]">
                    <h3 class="font-extrabold text-base text-zinc-900 leading-tight tracking-tight group-hover:text-black dark:text-zinc-50 dark:group-hover:text-white transition-colors mb-1">
                      {resume.title}
                    </h3>
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-zinc-450 dark:text-zinc-400 font-medium">
                      <span>{new Date(resume.updatedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                      <span>•</span>
                      <span class="flex items-center gap-1">
                        <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>
                        {resume.viewsCount} vistas
                      </span>
                    </div>
                  </div>

                  {/* Public Link Container (Sleek minimalist public url banner) */}
                  <div 
                    id={`link-container-${resume.id}`}
                    class={`mt-4 items-center justify-between rounded-xl border border-dashed border-zinc-200 bg-zinc-50/60 p-2 dark:border-zinc-800/40 dark:bg-zinc-950/40 ${resume.isPublished ? 'flex' : 'hidden'}`}
                  >
                    <span class="truncate text-[10px] font-mono text-zinc-500 dark:text-zinc-400 max-w-[190px]" id={`link-text-${resume.id}`}>
                      {`/cv/${resume.slug}`}
                    </span>
                    <button
                      class="copy-link-btn text-[10px] font-bold text-zinc-700 hover:text-black dark:text-zinc-300 dark:hover:text-white px-2 py-1 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-850 cursor-pointer transition-colors shadow-xs"
                      data-slug={resume.slug}
                      title="Copiar enlace público"
                    >
                      Copiar
                    </button>
                  </div>
                </div>

                {/* Bottom CTA Row (Go to Editor) */}
                <div class="mt-5 pt-3 border-t border-zinc-100 dark:border-zinc-850 flex items-center justify-between">
                  <span class="text-[10px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">
                    {resume.templateId === 'ats-classic' ? 'Formato ATS' : 'Formato Custom'}
                  </span>
                  
                  <a 
                    href={`/editor?id=${resume.id}`}
                    data-astro-prefetch
                    class="flex h-9 items-center justify-center gap-1.5 rounded-lg bg-zinc-900 hover:bg-black text-white dark:bg-zinc-100 dark:hover:bg-white dark:text-zinc-900 px-4 text-xs font-semibold active:scale-[0.97] transition-all shadow-xs"
                    title="Editar currículum"
                  >
                    <span>Editar CV</span>
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </main>
  </div>

  <!-- ==================== TOAST & MODAL OVERLAYS ==================== -->
  
  <!-- Toast Container -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Custom Create CV Modal -->
  <div id="create-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
    <div class="w-full max-w-md bg-white border border-zinc-200 rounded-xl shadow-xl p-6 transform scale-95 transition-all duration-300 dark:bg-zinc-900 dark:border-zinc-800 m-4">
      <h3 class="text-xl font-bold tracking-tight">Crear Nuevo Currículum</h3>
      <p class="text-sm text-zinc-500 mt-1 dark:text-zinc-400">Elige un nombre y una plantilla para comenzar.</p>
      
      <div class="mt-4 space-y-4">
        <div class="space-y-1.5">
          <label for="create-title" class="text-sm font-semibold text-zinc-700 dark:text-zinc-300">Nombre del currículum</label>
          <input 
            type="text" 
            id="create-title" 
            value="Mi Currículum Profesional"
            class="flex h-10 w-full rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-black dark:border-zinc-800 dark:bg-zinc-950 dark:focus:ring-white"
          />
        </div>

        <div class="space-y-1.5">
          <label for="create-template" class="text-sm font-semibold text-zinc-700 dark:text-zinc-300">Plantilla inicial</label>
          <select 
            id="create-template"
            class="flex h-10 w-full rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black dark:border-zinc-800 dark:bg-zinc-950 dark:focus:ring-white"
          >
            <option value="ats-classic">Plantilla ATS Classic</option>
            <option value="ats-modern" disabled>Plantilla ATS Modern (Próximamente)</option>
          </select>
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end gap-3">
        <button 
          id="close-create-btn"
          class="h-9 px-4 rounded-md border border-zinc-200 text-sm font-semibold hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-850 dark:text-zinc-300 cursor-pointer"
        >
          Cancelar
        </button>
        <button 
          id="confirm-create-btn"
          class="h-9 px-4 rounded-md bg-black text-white text-sm font-semibold hover:bg-zinc-800 dark:bg-white dark:text-black dark:hover:bg-zinc-200 cursor-pointer"
        >
          Crear
        </button>
      </div>
    </div>
  </div>

  <!-- Custom Rename CV Modal -->
  <div id="rename-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
    <div class="w-full max-w-md bg-white border border-zinc-200 rounded-xl shadow-xl p-6 transform scale-95 transition-all duration-300 dark:bg-zinc-900 dark:border-zinc-800 m-4">
      <h3 class="text-xl font-bold tracking-tight">Renombrar Currículum</h3>
      <p class="text-sm text-zinc-500 mt-1 dark:text-zinc-400">Ingresa el nuevo nombre para este currículum.</p>
      
      <input type="hidden" id="rename-id" />
      <div class="mt-4 space-y-1.5">
        <label for="rename-title" class="text-sm font-semibold text-zinc-700 dark:text-zinc-300">Nuevo Nombre</label>
        <input 
          type="text" 
          id="rename-title" 
          class="flex h-10 w-full rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-black dark:border-zinc-800 dark:bg-zinc-950 dark:focus:ring-white"
        />
      </div>

      <div class="mt-6 flex items-center justify-end gap-3">
        <button 
          id="close-rename-btn"
          class="h-9 px-4 rounded-md border border-zinc-200 text-sm font-semibold hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-850 dark:text-zinc-300 cursor-pointer"
        >
          Cancelar
        </button>
        <button 
          id="confirm-rename-btn"
          class="h-9 px-4 rounded-md bg-black text-white text-sm font-semibold hover:bg-zinc-800 dark:bg-white dark:text-black dark:hover:bg-zinc-200 cursor-pointer"
        >
          Renombrar
        </button>
      </div>
    </div>
  </div>

  <!-- Custom Confirmation Modal -->
  <div id="confirm-dialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
    <div class="w-full max-w-md bg-white border border-zinc-200 rounded-xl shadow-xl p-6 transform scale-95 transition-all duration-300 dark:bg-zinc-900 dark:border-zinc-800 m-4">
      <h3 id="confirm-dialog-title" class="text-xl font-bold tracking-tight">¿Estás seguro?</h3>
      <p id="confirm-dialog-desc" class="text-sm text-zinc-500 mt-1 dark:text-zinc-400">Esta acción no se puede deshacer.</p>

      <div class="mt-6 flex items-center justify-end gap-3">
        <button 
          id="close-confirm-btn"
          class="h-9 px-4 rounded-md border border-zinc-200 text-sm font-semibold hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-850 dark:text-zinc-300 cursor-pointer"
        >
          Cancelar
        </button>
        <button 
          id="accept-confirm-btn"
          class="h-9 px-4 rounded-md bg-red-600 text-white text-sm font-semibold hover:bg-red-700 active:scale-98 cursor-pointer transition-all"
        >
          Confirmar
        </button>
      </div>
    </div>
  </div>

  <script>
    // ==================== TOAST NOTIFICATION UTILITY ====================
    function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `flex items-center gap-3 px-4 py-3 rounded-lg border shadow-lg text-sm font-semibold transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto max-w-xs md:max-w-sm`;
      
      let bgClass = '';
      let borderClass = '';
      let textClass = '';
      let icon = '';

      if (type === 'success') {
        bgClass = 'bg-green-50 dark:bg-green-950/20';
        borderClass = 'border-green-200 dark:border-green-900/50';
        textClass = 'text-green-800 dark:text-green-300';
        icon = `<svg class="h-5 w-5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
      } else if (type === 'error') {
        bgClass = 'bg-red-50 dark:bg-red-950/20';
        borderClass = 'border-red-200 dark:border-red-900/50';
        textClass = 'text-red-800 dark:text-red-300';
        icon = `<svg class="h-5 w-5 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
      } else {
        bgClass = 'bg-zinc-50 dark:bg-zinc-900';
        borderClass = 'border-zinc-200 dark:border-zinc-800';
        textClass = 'text-zinc-800 dark:text-zinc-200';
        icon = `<svg class="h-5 w-5 text-zinc-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
      }

      toast.className += ` ${bgClass} ${borderClass} ${textClass}`;
      toast.innerHTML = `${icon} <span class="flex-1">${message}</span>`;
      
      container.appendChild(toast);

      // Animation in
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      // Animation out and removal
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        toast.addEventListener('transitionend', () => {
          toast.remove();
        });
      }, 4000);
    }

    // ==================== MODAL HELPERS ====================
    function openModal(modalId: string) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      const content = modal.querySelector('div');
      if (content) {
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
      }
    }

    function closeModal(modalId: string) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      const content = modal.querySelector('div');
      if (content) {
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
      }
    }

    // Bind Close Buttons
    document.getElementById('close-create-btn')?.addEventListener('click', () => closeModal('create-modal'));
    document.getElementById('close-rename-btn')?.addEventListener('click', () => closeModal('rename-modal'));
    document.getElementById('close-confirm-btn')?.addEventListener('click', () => closeModal('confirm-dialog'));

    // ==================== CONFIRM DIALOG HELPER ====================
    let currentConfirmAction: (() => Promise<void>) | null = null;

    function showConfirmDialog(title: string, desc: string, onConfirm: () => Promise<void>, confirmText = 'Confirmar', isDestructive = true) {
      const titleEl = document.getElementById('confirm-dialog-title');
      const descEl = document.getElementById('confirm-dialog-desc');
      if (titleEl) titleEl.innerText = title;
      if (descEl) descEl.innerText = desc;
      
      const acceptBtn = document.getElementById('accept-confirm-btn') as HTMLButtonElement;
      if (acceptBtn) {
        acceptBtn.innerText = confirmText;
        if (isDestructive) {
          acceptBtn.className = "h-9 px-4 rounded-md bg-red-600 text-white text-sm font-semibold hover:bg-red-700 active:scale-98 cursor-pointer transition-all";
        } else {
          acceptBtn.className = "h-9 px-4 rounded-md bg-black text-white text-sm font-semibold hover:bg-zinc-800 active:scale-98 cursor-pointer transition-all dark:bg-white dark:text-black dark:hover:bg-zinc-200";
        }
      }
      
      currentConfirmAction = onConfirm;
      openModal('confirm-dialog');
    }

    document.getElementById('accept-confirm-btn')?.addEventListener('click', async (e) => {
      if (currentConfirmAction) {
        const btn = e.target as HTMLButtonElement;
        const oldText = btn.innerText;
        btn.disabled = true;
        btn.innerText = 'Cargando...';
        try {
          await currentConfirmAction();
        } catch (e: any) {
          showToast(e.message || 'Error al procesar la acción', 'error');
        } finally {
          btn.disabled = false;
          btn.innerText = oldText;
          closeModal('confirm-dialog');
        }
      }
    });

    // ==================== LOGOUT FLOW ====================
    document.getElementById('logout-btn')?.addEventListener('click', () => {
      showConfirmDialog(
        '¿Cerrar Sesión?',
        '¿Estás seguro de que quieres cerrar tu sesión actual de CVForge?',
        async () => {
          const response = await fetch('/api/auth/logout', { method: 'POST' });
          if (response.ok) {
            window.location.href = '/';
          } else {
            showToast('Error al cerrar sesión', 'error');
          }
        },
        'Cerrar Sesión',
        true
      );
    });

    // ==================== CREATE CV FLOW ====================
    const newCvHandler = () => {
      // Reiniciar título y foco
      const titleInput = document.getElementById('create-title') as HTMLInputElement;
      if (titleInput) {
        titleInput.value = 'Mi Currículum Profesional';
      }
      openModal('create-modal');
      setTimeout(() => titleInput?.focus(), 100);
    };

    document.getElementById('new-cv-btn')?.addEventListener('click', newCvHandler);
    document.getElementById('new-cv-empty-btn')?.addEventListener('click', newCvHandler);

    document.getElementById('confirm-create-btn')?.addEventListener('click', async (e) => {
      const titleInput = document.getElementById('create-title') as HTMLInputElement;
      const title = titleInput?.value?.trim();
      const templateSelect = document.getElementById('create-template') as HTMLSelectElement;
      const templateId = templateSelect?.value || 'ats-classic';

      if (!title) {
        showToast('El título del currículum no puede estar vacío.', 'error');
        return;
      }

      const btn = e.target as HTMLButtonElement;
      btn.disabled = true;
      btn.innerText = 'Creando...';

      try {
        const response = await fetch('/api/resumes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, templateId }),
        });

        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Error al crear currículum');

        showToast('Currículum creado con éxito, redirigiendo...', 'success');
        setTimeout(() => {
          window.location.href = `/editor?id=${data.id}`;
        }, 800);

      } catch (err: any) {
        showToast(err.message || 'Error al crear currículum', 'error');
        btn.disabled = false;
        btn.innerText = 'Crear';
      }
    });

    // ==================== SEARCH / FILTER FLOW ====================
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    searchInput?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      const cards = document.querySelectorAll('.cv-card');
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.getAttribute('data-title')?.toLowerCase() || '';
        if (title.includes(query)) {
          (card as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      const emptyState = document.getElementById('empty-search-state');
      if (emptyState) {
        if (visibleCount === 0 && cards.length > 0) {
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
        } else {
          emptyState.classList.remove('flex');
          emptyState.classList.add('hidden');
        }
      }
    });

    // ==================== RENAME CV FLOW ====================
    // We will handle opening modal in delegation, but confirm rename remains direct
    document.getElementById('confirm-rename-btn')?.addEventListener('click', async (e) => {
      const idInput = document.getElementById('rename-id') as HTMLInputElement;
      const titleInput = document.getElementById('rename-title') as HTMLInputElement;

      const id = idInput?.value;
      const title = titleInput?.value?.trim();

      if (!id || !title) {
        showToast('El nombre del currículum es obligatorio.', 'error');
        return;
      }

      const btn = e.target as HTMLButtonElement;
      btn.disabled = true;
      btn.innerText = 'Renombrando...';

      try {
        const response = await fetch(`/api/resumes/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title }),
        });

        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Error al renombrar');

        showToast('Currículum renombrado con éxito.', 'success');
        closeModal('rename-modal');
        
        // Dynamically update card in DOM
        const card = document.getElementById(`cv-card-${id}`);
        if (card) {
          card.setAttribute('data-title', title);
          const heading = card.querySelector('h3');
          if (heading) heading.textContent = title;
          
          const renameBtn = card.querySelector('.rename-cv-btn');
          if (renameBtn) renameBtn.setAttribute('data-title', title);
        }

      } catch (err: any) {
        showToast(err.message || 'Error al renombrar currículum', 'error');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Renombrar';
      }
    });

    // ==================== DYNAMIC EVENT DELEGATION FOR CARD ACTIONS ====================
    function updateResumesCount() {
      const cards = document.querySelectorAll('.cv-card');
      const countSpan = document.querySelector('main > div:nth-child(2) > span, main > div.mt-6 > span');
      if (countSpan) {
        countSpan.textContent = `${cards.length} ${cards.length === 1 ? 'currículum registrado' : 'currículums registrados'}`;
      }
      if (cards.length === 0) {
        window.location.reload();
      }
    }

    const grid = document.getElementById('resumes-grid');
    if (grid) {
      grid.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;

        // 1. RENAME CV CLICK
        const renameBtn = target.closest('.rename-cv-btn') as HTMLButtonElement;
        if (renameBtn) {
          const id = renameBtn.getAttribute('data-id');
          const title = renameBtn.getAttribute('data-title');
          
          if (!id || !title) return;

          const renameIdInput = document.getElementById('rename-id') as HTMLInputElement;
          const renameTitleInput = document.getElementById('rename-title') as HTMLInputElement;

          if (renameIdInput) renameIdInput.value = id;
          if (renameTitleInput) renameTitleInput.value = title;

          openModal('rename-modal');
          setTimeout(() => renameTitleInput?.focus(), 100);
          return;
        }

        // 2. DUPLICATE CV CLICK
        const duplicateBtn = target.closest('.duplicate-cv-btn') as HTMLButtonElement;
        if (duplicateBtn) {
          const id = duplicateBtn.getAttribute('data-id');
          if (!id) return;

          duplicateBtn.disabled = true;
          const oldTitle = duplicateBtn.title;
          duplicateBtn.title = 'Duplicando...';

          try {
            const response = await fetch('/api/resumes/duplicate', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id }),
            });

            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Error al duplicar');

            showToast(`Currículum duplicado como "${data.title}"`, 'success');
            
            // Dynamic card duplication
            const originalCard = document.getElementById(`cv-card-${id}`);
            if (originalCard) {
              const clonedCard = originalCard.cloneNode(true) as HTMLElement;
              const newId = data.id;
              const newTitle = data.title;

              clonedCard.id = `cv-card-${newId}`;
              clonedCard.setAttribute('data-title', newTitle);
              
              const heading = clonedCard.querySelector('h3');
              if (heading) heading.textContent = newTitle;

              // Update data attributes on nested elements
              clonedCard.querySelectorAll('[data-id]').forEach(el => {
                el.setAttribute('data-id', newId);
              });
              clonedCard.querySelectorAll('[data-title]').forEach(el => {
                el.setAttribute('data-title', newTitle);
              });

              // Reset publish toggle status
              const publishToggle = clonedCard.querySelector('.publish-toggle-btn') as HTMLButtonElement;
              if (publishToggle) {
                publishToggle.setAttribute('data-published', 'false');
                publishToggle.className = "publish-toggle-btn text-[10px] font-semibold px-2.5 py-1 rounded-md border shadow-xs transition-all active:scale-95 cursor-pointer shrink-0 flex items-center gap-1.5 bg-zinc-100/70 text-zinc-650 border-zinc-200/60 dark:bg-zinc-800/40 dark:text-zinc-400 dark:border-zinc-800/20";
                
                const dot = publishToggle.querySelector('span:first-child');
                if (dot) dot.className = "h-1.5 w-1.5 rounded-full shrink-0 bg-zinc-450 dark:bg-zinc-500";
                
                const text = publishToggle.querySelector('span:last-child');
                if (text) text.textContent = 'Privado';
              }

              // Reset link container
              const linkContainer = clonedCard.querySelector('[id^="link-container-"]') as HTMLElement;
              if (linkContainer) {
                linkContainer.id = `link-container-${newId}`;
                linkContainer.className = "mt-4 items-center justify-between rounded-xl border border-dashed border-zinc-200 bg-zinc-50/60 p-2 dark:border-zinc-800/40 dark:bg-zinc-950/40 hidden";
              }

              const linkText = clonedCard.querySelector('[id^="link-text-"]') as HTMLElement;
              if (linkText) {
                linkText.id = `link-text-${newId}`;
                linkText.textContent = `/cv/cv-${newId}`;
              }

              const copyBtn = clonedCard.querySelector('.copy-link-btn') as HTMLButtonElement;
              if (copyBtn) {
                copyBtn.setAttribute('data-slug', `cv-${newId}`);
              }

              // Update Edit link URL
              const editLink = clonedCard.querySelector('a[href^="/editor?id="]') as HTMLAnchorElement;
              if (editLink) {
                editLink.href = `/editor?id=${newId}`;
              }

              // Generate new top gradient & glow colors based on dynamic code
              const gradientsList = [
                'from-violet-500 via-purple-500 to-pink-500',
                'from-cyan-500 via-blue-500 to-indigo-500',
                'from-amber-400 via-orange-500 to-pink-500',
                'from-emerald-400 via-teal-500 to-cyan-500',
                'from-rose-500 via-red-500 to-orange-500',
                'from-indigo-500 via-purple-600 to-fuchsia-500',
              ];
              let sum = 0;
              for (let i = 0; i < newId.length; i++) {
                sum += newId.charCodeAt(i);
              }
              const newGrad = gradientsList[sum % gradientsList.length];

              const topBar = clonedCard.querySelector('.h-1, .absolute.top-0.left-0.right-0') as HTMLElement;
              if (topBar) {
                topBar.className = `absolute top-0 left-0 right-0 h-1 group-hover:h-1.5 bg-gradient-to-r ${newGrad} rounded-t-2xl transition-all duration-300`;
              }
              
              const glow = clonedCard.querySelector('.-z-10, .absolute.inset-0.-z-10') as HTMLElement;
              if (glow) {
                glow.className = `absolute inset-0 -z-10 bg-gradient-to-r ${newGrad} opacity-0 group-hover:opacity-[0.05] blur-xl transition-all duration-300 rounded-2xl`;
              }

              // Setup styles for nice fade-in animation
              clonedCard.style.opacity = '0';
              clonedCard.style.transform = 'scale(0.9) translateY(15px)';
              clonedCard.style.transition = 'all 0.4s cubic-bezier(0.16, 1, 0.3, 1)';

              // Insert directly before original card
              grid.insertBefore(clonedCard, originalCard);

              // Trigger transition on next frame
              setTimeout(() => {
                clonedCard.style.opacity = '1';
                clonedCard.style.transform = 'scale(1) translateY(0)';
              }, 20);

              // Update control count
              updateResumesCount();
            }

          } catch (err: any) {
            showToast(err.message || 'Error al duplicar currículum', 'error');
          } finally {
            duplicateBtn.disabled = false;
            duplicateBtn.title = oldTitle;
          }
          return;
        }

        // 3. PUBLISH TOGGLE CLICK
        const publishBtn = target.closest('.publish-toggle-btn') as HTMLButtonElement;
        if (publishBtn) {
          const id = publishBtn.getAttribute('data-id');
          const isCurrentlyPublished = publishBtn.getAttribute('data-published') === 'true';
          
          if (!id) return;

          publishBtn.disabled = true;
          const newPublishedState = !isCurrentlyPublished;

          try {
            const response = await fetch(`/api/resumes/${id}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ isPublished: newPublishedState }),
            });

            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Error al cambiar estado de publicación');

            showToast(newPublishedState ? 'Currículum publicado con éxito' : 'Currículum ahora es privado', 'success');
            
            // Local DOM update
            publishBtn.setAttribute('data-published', newPublishedState ? 'true' : 'false');
            
            const dot = publishBtn.querySelector('span:first-child');
            if (dot) {
              dot.className = `h-1.5 w-1.5 rounded-full shrink-0 ${newPublishedState ? 'bg-emerald-500 animate-pulse' : 'bg-zinc-450 dark:bg-zinc-500'}`;
            }

            const text = publishBtn.querySelector('span:last-child');
            if (text) {
              text.textContent = newPublishedState ? 'Público' : 'Privado';
            }

            if (newPublishedState) {
              publishBtn.className = "publish-toggle-btn text-[10px] font-semibold px-2.5 py-1 rounded-md border shadow-xs transition-all active:scale-95 cursor-pointer shrink-0 flex items-center gap-1.5 bg-emerald-50/80 text-emerald-700 border-emerald-200/60 dark:bg-emerald-950/20 dark:text-emerald-400 dark:border-emerald-900/30";
            } else {
              publishBtn.className = "publish-toggle-btn text-[10px] font-semibold px-2.5 py-1 rounded-md border shadow-xs transition-all active:scale-95 cursor-pointer shrink-0 flex items-center gap-1.5 bg-zinc-100/70 text-zinc-650 border-zinc-200/60 dark:bg-zinc-850/50 dark:text-zinc-400 dark:border-zinc-800/20";
            }

            const linkContainer = document.getElementById(`link-container-${id}`);
            if (linkContainer) {
              if (newPublishedState) {
                linkContainer.classList.remove('hidden');
                linkContainer.classList.add('flex');
              } else {
                linkContainer.classList.remove('flex');
                linkContainer.classList.add('hidden');
              }
            }

          } catch (err: any) {
            showToast(err.message || 'Error al actualizar publicación', 'error');
          } finally {
            publishBtn.disabled = false;
          }
          return;
        }

        // 4. COPY LINK CLICK
        const copyBtn = target.closest('.copy-link-btn') as HTMLButtonElement;
        if (copyBtn) {
          const slug = copyBtn.getAttribute('data-slug');
          if (!slug) return;

          const absoluteUrl = `${window.location.origin}/cv/${slug}`;
          navigator.clipboard.writeText(absoluteUrl).then(() => {
            showToast('Enlace de CV copiado al portapapeles', 'success');
          }).catch(() => {
            showToast('Error al copiar el enlace', 'error');
          });
          return;
        }

        // 5. DELETE CV CLICK
        const deleteBtn = target.closest('.delete-cv-btn') as HTMLButtonElement;
        if (deleteBtn) {
          const id = deleteBtn.getAttribute('data-id');
          if (!id) return;

          showConfirmDialog(
            '¿Eliminar Currículum?',
            '¿Estás completamente seguro de que deseas eliminar este currículum? Esta acción borrará de forma permanente todos los datos asociados y no se puede deshacer.',
            async () => {
              const response = await fetch(`/api/resumes?id=${id}`, {
                method: 'DELETE',
              });

              const data = await response.json();
              if (!response.ok) throw new Error(data.error || 'Error al eliminar');

              showToast('Currículum eliminado correctamente.', 'success');

              // Smooth fade out
              const card = document.getElementById(`cv-card-${id}`);
              if (card) {
                card.style.transition = 'all 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
                card.style.opacity = '0';
                card.style.transform = 'scale(0.9) translateY(15px)';
                setTimeout(() => {
                  card.remove();
                  updateResumesCount();
                }, 400);
              }
            },
            'Eliminar Currículum',
            true
          );
          return;
        }
      });
    }
  </script>
</Layout>
