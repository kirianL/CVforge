---
import Layout from '../layouts/Layout.astro';
import { getUserFromRequest } from '../lib/auth';
import { getDb } from '../lib/db';

const user = await getUserFromRequest(Astro.request);

// Si no está autenticado, redirigir al login
if (!user) {
  return Astro.redirect('/login');
}

const prisma = getDb();
const resumes = await prisma.resume.findMany({
  where: { userId: user.id },
  orderBy: { updatedAt: 'desc' },
});
---

<Layout title="Panel de Control | CVForge">
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-950 select-none">
    
    <!-- Dashboard Header -->
    <header class="sticky top-0 z-50 w-full border-b border-zinc-200 bg-white/70 backdrop-blur-md dark:border-zinc-800/30 dark:bg-zinc-950/70">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-2">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-black text-white font-bold text-xl dark:bg-white dark:text-black">
            CF
          </div>
          <span class="text-xl font-bold tracking-tight">CV<span class="text-zinc-500">Forge</span></span>
        </div>

        <div class="flex items-center gap-4">
          <span class="text-sm text-zinc-650 dark:text-zinc-400 font-medium">Hola, {user.name}</span>
          <button 
            id="logout-btn"
            class="text-sm font-medium text-red-500 hover:text-red-650 transition-colors"
          >
            Cerrar Sesión
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200 pb-5 dark:border-zinc-850">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Mis Currículums</h1>
          <p class="text-sm text-zinc-500 mt-1">Crea y gestiona tus currículums optimizados para ATS</p>
        </div>
        <button 
          id="new-cv-btn"
          class="inline-flex h-10 items-center justify-center rounded-md bg-black px-4 text-sm font-semibold text-white shadow hover:bg-zinc-800 active:scale-98 transition-all dark:bg-white dark:text-black dark:hover:bg-zinc-200"
        >
          + Crear Currículum
        </button>
      </div>

      <!-- Resumes List -->
      <div class="mt-8">
        {resumes.length === 0 ? (
          <!-- Empty State -->
          <div class="flex flex-col items-center justify-center border-2 border-dashed border-zinc-250 rounded-xl p-16 text-center dark:border-zinc-800">
            <svg class="h-12 w-12 text-zinc-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
            <h3 class="text-lg font-bold">No tienes currículums aún</h3>
            <p class="text-sm text-zinc-500 mt-1 max-w-sm">Comienza creando tu primer hoja de vida optimizada para pasar los filtros automáticos de reclutamiento.</p>
            <button 
              id="new-cv-empty-btn"
              class="mt-4 inline-flex h-9 items-center justify-center rounded-md bg-zinc-900 px-4 text-xs font-semibold text-white shadow hover:bg-zinc-850 dark:bg-white dark:text-black dark:hover:bg-zinc-200"
            >
              Crear tu primer CV
            </button>
          </div>
        ) : (
          <!-- Resumes Grid -->
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {resumes.map((resume) => (
              <div 
                key={resume.id}
                class="group relative flex flex-col justify-between rounded-xl border border-zinc-200 bg-white p-6 shadow-sm hover:shadow-md hover:border-zinc-300 transition-all dark:bg-zinc-900 dark:border-zinc-800"
              >
                <div>
                  <div class="flex justify-between items-start">
                    <h3 class="font-bold text-lg leading-tight tracking-tight group-hover:text-violet-650 transition-colors">
                      {resume.title}
                    </h3>
                  </div>
                  <p class="text-xs text-zinc-450 mt-2">
                    Actualizado: {new Date(resume.updatedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </p>
                  <div class="flex items-center gap-4 mt-4 text-xs text-zinc-500">
                    <span class="flex items-center gap-1">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                      </svg>
                      {resume.viewsCount} vistas
                    </span>
                    <span>• {resume.templateId === 'ats-classic' ? 'Plantilla ATS Classic' : 'Plantilla Custom'}</span>
                  </div>
                </div>

                <div class="mt-6 flex items-center justify-between border-t border-zinc-150 pt-4 dark:border-zinc-850">
                  <a 
                    href={`/editor?id=${resume.id}`}
                    class="inline-flex h-8 items-center justify-center rounded-md bg-zinc-900 px-3 text-xs font-semibold text-white shadow-sm hover:bg-zinc-800 dark:bg-white dark:text-black dark:hover:bg-zinc-200"
                  >
                    Editar CV
                  </a>
                  <button 
                    class="delete-cv-btn text-xs font-medium text-red-500 hover:text-red-700 transition-colors px-2 py-1"
                    data-id={resume.id}
                  >
                    Eliminar
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </main>
  </div>

  <script>
    // Cerrar sesión
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      if (confirm('¿Estás seguro de que quieres cerrar sesión?')) {
        const response = await fetch('/api/auth/logout', { method: 'POST' });
        if (response.ok) {
          window.location.href = '/';
        }
      }
    });

    // Crear currículum
    const handleNewCV = async () => {
      const title = prompt('Ingresa un nombre para tu currículum:', 'Mi Currículum Profesional');
      if (!title) return;

      try {
        const response = await fetch('/api/resumes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title }),
        });

        const data = await response.json();
        if (!response.ok) throw new Error(data.error);

        // Redirigir al editor
        window.location.href = `/editor?id=${data.id}`;

      } catch (err: any) {
        alert(err.message || 'Error al crear currículum');
      }
    };

    document.getElementById('new-cv-btn')?.addEventListener('click', handleNewCV);
    document.getElementById('new-cv-empty-btn')?.addEventListener('click', handleNewCV);

    // Eliminar currículum
    document.querySelectorAll('.delete-cv-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.target as HTMLButtonElement).getAttribute('data-id');
        if (!id) return;

        if (confirm('¿Estás seguro de que deseas eliminar este currículum? Esta acción no se puede deshacer.')) {
          try {
            const response = await fetch(`/api/resumes?id=${id}`, {
              method: 'DELETE',
            });

            const data = await response.json();
            if (!response.ok) throw new Error(data.error);

            // Recargar la página
            window.location.reload();

          } catch (err: any) {
            alert(err.message || 'Error al eliminar currículum');
          }
        }
      });
    });
  </script>
</Layout>
