datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  RECRUITER
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  name          String?
  passwordHash  String?            // Nullable si inicia sesión con OAuth
  role          Role               @default(USER)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  // Relaciones
  sessions      Session[]
  accounts      Account[]
  resumes       Resume[]
  subscription  Subscription?
  auditLogs     AuditLog[]

  @@index([email])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String   // OAuth provider type
  provider          String   // google, github, linkedin
  providerAccountId String
  refreshToken      String?  @db.Text
  accessToken       String?  @db.Text
  expiresAt         Int?
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Resume {
  id          String   @id @default(cuid())
  userId      String
  title       String   // Nombre interno del CV (ej: "CV Desarrollador Fullstack")
  slug        String   @unique // URL pública (ej: "juan-perez-cv")
  isPublished Boolean  @default(false)
  language    String   @default("es")
  templateId  String   @default("ats-classic")
  content     Json     // Contenido estructurado del CV (esquema validado por Zod)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  viewsCount  Int      @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slug])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  status               SubscriptionStatus @default(FREE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  priceId              String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeSubscriptionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // ej: "auth.login", "cv.export.pdf"
  ipAddress String?
  details   Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}
